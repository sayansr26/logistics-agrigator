#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running tests before push..."

# Run tests only in workspaces that define them
for service in backend/* frontend; do
  if [ -f "$service/package.json" ] && grep -q '"test"' "$service/package.json"; then
    yarn --cwd "$service" test || exit 1
  fi
done

# Run type checking for TypeScript projects
echo "🔍 Type checking..."

for service in backend/*; do
  if [ -f "$service/package.json" ] && grep -q '"type-check"' "$service/package.json"; then
    yarn --cwd "$service" type-check || exit 1
  fi
done

# Frontend type-check is not enforced here because the current repo baseline
# has unrelated existing TypeScript errors; use the production build as the
# frontend safety gate until that baseline is cleaned up.
echo "ℹ️  Skipping frontend type-check in pre-push; enforcing frontend build instead"

# Run build to ensure packages that define a build script still compile
echo "🏗️ Build check..."

yarn --cwd frontend build || exit 1

for service in backend/*; do
  if [ -f "$service/package.json" ] && grep -q '"build"' "$service/package.json"; then
    yarn --cwd "$service" build || exit 1
  fi
done

echo "✅ Pre-push checks passed!"
