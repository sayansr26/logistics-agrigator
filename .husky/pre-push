#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running tests before push..."

# Run tests for all workspaces
pnpm run test

# Run type checking for TypeScript projects  
echo "🔍 Type checking..."
# TODO: Fix frontend TypeScript errors and re-enable
# pnpm --filter frontend run type-check
pnpm --filter "backend/*" run type-check --if-present

# Run build to ensure everything compiles (skip frontend for now)
echo "🏗️ Build check..."
pnpm --filter "backend/*" run build --if-present

echo "✅ Pre-push checks passed!"
echo ""
echo "💡 To manually update memory bank when needed:"
echo "   ./scripts/update-memory-and-changelog.sh"