# ============================================================================
# UAT ENVIRONMENT CONFIGURATION (EXAMPLE — copy to .env.uat and fill real values)
# ============================================================================
# Runs alongside PROD on the SAME host, fully isolated via a distinct
# COMPOSE_PROJECT_NAME (separate networks + volumes), distinct container names
# (-uat suffix), and distinct published host ports (4000/4001).
# Used by: make deploy-uat  (docker-compose.production.yml --env-file .env.uat)
# NEVER commit real secrets — keep this out of git like .env.production.
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
COMPOSE_PROJECT_NAME=logistics-uat
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# REGISTRY / IMAGE TAG (pull-only deploy)
# ============================================================================
# `make release-uat` pushes ghcr.io/sayansr26/logistics-*:uat; deploy-uat pulls it.
REGISTRY=ghcr.io/sayansr26
IMAGE_TAG=uat

# ============================================================================
# DATABASE (UAT — use its OWN passwords, separate from PROD)
# ============================================================================
POSTGRES_USER=logistics
POSTGRES_PASSWORD=CHANGE_ME_UAT_STRONG_PASSWORD_HERE
POSTGRES_DB=logistics_main
DB_PORT=5432

# Database Names (same names; isolated because the postgres volume is per-project)
AUTH_DATABASE_NAME=logistics_auth
USER_DATABASE_NAME=logistics_users
SHIPMENT_DATABASE_NAME=logistics_shipments
PARTNER_DATABASE_NAME=logistics_partners
WALLET_DATABASE_NAME=logistics_wallet
SUPPORT_DATABASE_NAME=logistics_support
PLATFORM_DATABASE_NAME=logistics_platforms
LICENSE_DATABASE_NAME=logistics_license

# ============================================================================
# REDIS
# ============================================================================
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================================================
# SERVICE PORTS
# ============================================================================
# Internal container ports (unchanged — each stack is on its own network).
FRONTEND_PORT=3000
API_GATEWAY_PORT=3001
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
SHIPMENT_SERVICE_PORT=3004
PARTNER_SERVICE_PORT=3005
WALLET_SERVICE_PORT=3006
SUPPORT_SERVICE_PORT=3007
PLATFORM_SERVICE_PORT=3008
LICENSE_SERVICE_PORT=3009

# Published HOST ports — MUST differ from PROD (3001/3000) to coexist on one host.
API_GATEWAY_HOST_PORT=4001
FRONTEND_HOST_PORT=4000

# ============================================================================
# Container Names (REQUIRED for UAT — override the -prod defaults so the two
# stacks never collide on container names / postgres init).
# ============================================================================
POSTGRES_CONTAINER_NAME=logistics-postgres-uat
REDIS_CONTAINER_NAME=logistics-redis-uat
API_GATEWAY_CONTAINER_NAME=logistics-api-gateway-uat
AUTH_SERVICE_CONTAINER_NAME=logistics-auth-service-uat
USER_SERVICE_CONTAINER_NAME=logistics-user-service-uat
SHIPMENT_SERVICE_CONTAINER_NAME=logistics-shipment-service-uat
PARTNER_SERVICE_CONTAINER_NAME=logistics-partner-service-uat
WALLET_SERVICE_CONTAINER_NAME=logistics-wallet-service-uat
SUPPORT_SERVICE_CONTAINER_NAME=logistics-support-service-uat
PLATFORM_SERVICE_CONTAINER_NAME=logistics-platform-service-uat
LICENSE_SERVICE_CONTAINER_NAME=logistics-license-service-uat
FRONTEND_CONTAINER_NAME=logistics-frontend-uat

# ============================================================================
# JWT (UAT — use its OWN secrets, separate from PROD)
# ============================================================================
JWT_SECRET=CHANGE_ME_UAT_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=604800
INTERNAL_SECRET=CHANGE_ME_UAT_ANOTHER_STRONG_SECRET_HERE

# ============================================================================
# CORS (UAT / staging domains)
# ============================================================================
CROSS_ORIGIN=https://uat.yourdomain.com
DEVELOPMENT_ORIGINS=http://localhost:3000
PRODUCTION_ORIGINS=https://uat.yourdomain.com
STAGING_ORIGINS=https://uat.yourdomain.com,http://localhost:4000,http://localhost:4001

# ============================================================================
# FRONTEND
# ============================================================================
# NEXT_PUBLIC_API_URL is baked as "" (same-origin) in the image; kept for parity.
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_APP_ENV=uat

# ============================================================================
# EXTERNAL APIs (UAT — point at sandbox/test creds where available)
# ============================================================================
EXTERNAL_WALLET_API_URL=https://wapi.websiteduniya.com/api/v1
EXTERNAL_WALLET_SECRET_KEY=YOUR_UAT_WALLET_SECRET_KEY
EXTERNAL_WALLET_USER_ID=YOUR_UAT_WALLET_USER_ID
EXTERNAL_WALLET_JWT_TOKEN=

PARTNER_SERVICE_EXTERNAL_URL=https://calc.websiteduniya.com
PARTNER_SERVICE_API_KEY=YOUR_UAT_PARTNER_API_KEY
SERVICE_ID=YOUR_UAT_SERVICE_ID
HMAC_SECRET=YOUR_UAT_HMAC_SECRET
API_SECRET_SALT=YOUR_UAT_API_SECRET_SALT

DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=YOUR_UAT_DELHIVERY_TOKEN
BLUEDART_API_URL=https://apigateway.bluedart.com
BLUEDART_API_TOKEN=YOUR_UAT_BLUEDART_TOKEN
DELHIVERY_CLIENT_NAME=YOUR_UAT_DELHIVERY_CLIENT_NAME

BLUEDART_API_KEY=YOUR_UAT_BLUEDART_API_KEY
BLUEDART_LICENSE_KEY=YOUR_UAT_BLUEDART_LICENSE_KEY
BLUEDART_LOGIN_ID=YOUR_UAT_BLUEDART_LOGIN_ID
BLUEDART_CUSTOMER_CODE=YOUR_UAT_BLUEDART_CUSTOMER_CODE

# Courier Adapter Settings
COURIER_API_TIMEOUT=15000
COURIER_RETRY_ATTEMPTS=3
COURIER_CACHE_TTL=300

# ============================================================================
# WALLET SERVICE
# ============================================================================
WALLET_JWT_EXPIRES_IN=8h
WALLET_JWT_REFRESH_EXPIRES_IN=2592000
WALLET_DEFAULT_CLIENT_CODE=LOGISTICS

# ============================================================================
# CACHE SETTINGS
# ============================================================================
CACHE_WALLET_TTL=600
CACHE_BALANCE_TTL=300
CACHE_TRANSACTIONS_TTL=60

# ============================================================================
# CIRCUIT BREAKER
# ============================================================================
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_STRICT_MAX=50
RATE_LIMIT_BALANCE_MAX=100
RATE_LIMIT_TRANSACTION_MAX=30

# ============================================================================
# LICENSE SERVICE
# ============================================================================
LICENSE_SECRET_KEY=YOUR_UAT_LICENSE_SECRET_KEY
LICENSE_SIGNING_KEY=YOUR_UAT_LICENSE_SIGNING_KEY
LICENSE_JWT_EXPIRES_IN=8h
LICENSE_JWT_REFRESH_EXPIRES_IN=604800

# ============================================================================
# SHOPIFY
# ============================================================================
SHOPIFY_CLIENT_ID=YOUR_UAT_SHOPIFY_CLIENT_ID
SHOPIFY_CLIENT_SECRET=YOUR_UAT_SHOPIFY_CLIENT_SECRET

# ============================================================================
# SERVICE NAMES
# ============================================================================
SERVICE_NAME=api-gateway
SHIPMENT_SERVICE_NAME=shipment-service
SUPPORT_SERVICE_NAME=support-service
PLATFORM_SERVICE_NAME=platform-service
LICENSE_SERVICE_NAME=license-service

# ============================================================================
# DEPLOYMENT CONFIGURATION (same host as PROD)
# ============================================================================
DEPLOY_PATH=/var/www/sub-solution
SERVER_HOST=103.17.193.231
SERVER_USER=gitlab-runner
SERVER_PORT=22

# ============================================
# AI PROVIDER (DeepSeek-compatible)
# ============================================

AI_DEFAULT_PROVIDER=DEEPSEEK
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
AI_ANOMALY_ENABLED=false
