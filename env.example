# ============================================
# Logistics Aggregator - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# GENERAL SETTINGS
# ============================================
NODE_ENV=development

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics123
POSTGRES_DB=logistics
POSTGRES_CONTAINER_NAME=logistics-postgres
DB_PORT=5432

# Service-specific database names
AUTH_DATABASE_NAME=logistics_auth
USER_DATABASE_NAME=logistics_users
SHIPMENT_DATABASE_NAME=logistics_shipments
PARTNER_DATABASE_NAME=logistics_partners
WALLET_DATABASE_NAME=logistics_wallet
SUPPORT_DATABASE_NAME=logistics_support
PLATFORM_DATABASE_NAME=logistics_platforms
LICENSE_DATABASE_NAME=logistics_license

# ============================================
# REDIS
# ============================================
REDIS_CONTAINER_NAME=logistics-redis
REDIS_PORT=6379

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=2592000

# Inter-service communication secrets
INTERNAL_SECRET=your-internal-service-secret-change-in-production

# ============================================
# API GATEWAY
# ============================================
API_GATEWAY_PORT=3001
API_GATEWAY_CONTAINER_NAME=logistics-api-gateway
SERVICE_NAME=api-gateway
CROSS_ORIGIN=http://localhost:3000

# ============================================
# AUTH SERVICE
# ============================================
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_CONTAINER_NAME=logistics-auth-service

# ============================================
# USER SERVICE
# ============================================
USER_SERVICE_PORT=8002
USER_SERVICE_CONTAINER_NAME=logistics-user-service

# ============================================
# SHIPMENT SERVICE
# ============================================
SHIPMENT_SERVICE_PORT=8003
SHIPMENT_SERVICE_CONTAINER_NAME=logistics-shipment-service
SHIPMENT_SERVICE_NAME=shipment-service

# ============================================
# PARTNER SERVICE
# ============================================
PARTNER_SERVICE_PORT=8004
PARTNER_SERVICE_CONTAINER_NAME=logistics-partner-service

# External Courier API URLs
DELHIVERY_API_URL=https://api.delhivery.com
BLUEDART_API_URL=https://api.bluedart.com
DTDC_API_URL=https://api.dtdc.com

# ============================================
# WALLET SERVICE
# ============================================
WALLET_SERVICE_PORT=8005
WALLET_SERVICE_CONTAINER_NAME=logistics-wallet-service

# External Wallet API Configuration
EXTERNAL_WALLET_API_URL=https://your-wallet-api.com
EXTERNAL_WALLET_SECRET_KEY=your-wallet-secret-key
EXTERNAL_WALLET_USER_ID=wallet-service
EXTERNAL_WALLET_JWT_TOKEN=your-wallet-jwt-token

# Wallet JWT Configuration
WALLET_JWT_EXPIRES_IN=8h
WALLET_JWT_REFRESH_EXPIRES_IN=2592000

# Default Client Configuration
WALLET_DEFAULT_CLIENT_CODE=DEFAULT

# Cache Configuration (in seconds)
CACHE_WALLET_TTL=600
CACHE_BALANCE_TTL=300
CACHE_TRANSACTIONS_TTL=60

# Circuit Breaker Configuration (in milliseconds)
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_STRICT_MAX=50
RATE_LIMIT_BALANCE_MAX=100
RATE_LIMIT_TRANSACTION_MAX=30

# ============================================
# SUPPORT SERVICE
# ============================================
SUPPORT_SERVICE_PORT=8006
SUPPORT_SERVICE_CONTAINER_NAME=logistics-support-service
SUPPORT_SERVICE_NAME=support-service

# ============================================
# PLATFORM SERVICE
# ============================================
PLATFORM_SERVICE_PORT=8007
PLATFORM_SERVICE_CONTAINER_NAME=logistics-platform-service
PLATFORM_SERVICE_NAME=platform-service

# Shopify Integration
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# ============================================
# LICENSE SERVICE
# ============================================
LICENSE_SERVICE_PORT=8008
LICENSE_SERVICE_CONTAINER_NAME=logistics-license-service
LICENSE_SERVICE_NAME=license-service

# License JWT Configuration
LICENSE_JWT_EXPIRES_IN=8h
LICENSE_JWT_REFRESH_EXPIRES_IN=604800

# License Encryption Keys (CHANGE IN PRODUCTION!)
LICENSE_SECRET_KEY=your-license-secret-key-32-chars-min
LICENSE_SIGNING_KEY=your-license-signing-key-32-chars

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=3000
FRONTEND_CONTAINER_NAME=logistics-frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=development


# ============================================
# SHARED
# ============================================
DEVELOPMENT_ORIGINS=http://localhost:3000
PRODUCTION_ORIGINS=https://logistics.tech-sayan.space
STAGING_ORIGINS=https://logistics.tech-sayan.space
