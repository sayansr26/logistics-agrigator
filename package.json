{
  "name": "logistics-aggregator-portal",
  "version": "1.0.0",
  "description": "Comprehensive logistics management solution for India",
  "private": true,
  "workspaces": [
    "frontend",
    "backend/*",
    "shared"
  ],
  "scripts": {
    "install:all": "yarn install",
    "prepare": "husky install",
    "setup:dev": "./scripts/setup.sh && docker-compose --profile all-services up -d && ./scripts/init-databases.sh",
    "dev": "docker-compose --profile all-services up",
    "dev:detached": "docker-compose --profile all-services up -d",
    "dev:frontend": "docker-compose -f docker-compose.frontend.yml up",
    "dev:frontend:detached": "docker-compose -f docker-compose.frontend.yml up -d",
    "stop": "docker-compose --profile all-services down",
    "stop:frontend": "docker-compose -f docker-compose.frontend.yml down",
    "logs": "docker-compose logs -f",
    "logs:frontend": "docker-compose -f docker-compose.frontend.yml logs -f",
    "production:build": "docker-compose -f docker-compose.production.yml --env-file .env.production build",
    "production:up": "docker-compose -f docker-compose.production.yml --env-file .env.production up -d",
    "production:down": "docker-compose -f docker-compose.production.yml --env-file .env.production down",
    "production:logs": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f",
    "production:restart": "docker-compose -f docker-compose.production.yml --env-file .env.production restart",
    "production:ps": "docker-compose -f docker-compose.production.yml --env-file .env.production ps",
    "production:restart:frontend": "docker-compose -f docker-compose.production.yml --env-file .env.production restart frontend",
    "production:restart:api-gateway": "docker-compose -f docker-compose.production.yml --env-file .env.production restart api-gateway",
    "production:restart:auth": "docker-compose -f docker-compose.production.yml --env-file .env.production restart auth-service",
    "production:restart:user": "docker-compose -f docker-compose.production.yml --env-file .env.production restart user-service",
    "production:restart:shipment": "docker-compose -f docker-compose.production.yml --env-file .env.production restart shipment-service",
    "production:restart:partner": "docker-compose -f docker-compose.production.yml --env-file .env.production restart partner-service",
    "production:restart:wallet": "docker-compose -f docker-compose.production.yml --env-file .env.production restart wallet-service",
    "production:restart:support": "docker-compose -f docker-compose.production.yml --env-file .env.production restart support-service",
    "production:restart:platform": "docker-compose -f docker-compose.production.yml --env-file .env.production restart platform-service",
    "production:restart:license": "docker-compose -f docker-compose.production.yml --env-file .env.production restart license-service",
    "production:restart:postgres": "docker-compose -f docker-compose.production.yml --env-file .env.production restart postgres",
    "production:restart:redis": "docker-compose -f docker-compose.production.yml --env-file .env.production restart redis",
    "production:restart:backend": "docker-compose -f docker-compose.production.yml --env-file .env.production restart api-gateway auth-service user-service shipment-service partner-service wallet-service support-service platform-service license-service",
    "production:restart:all": "docker-compose -f docker-compose.production.yml --env-file .env.production restart",
    "production:build:frontend": "docker-compose -f docker-compose.production.yml --env-file .env.production build frontend",
    "production:build:api-gateway": "docker-compose -f docker-compose.production.yml --env-file .env.production build api-gateway",
    "production:build:auth": "docker-compose -f docker-compose.production.yml --env-file .env.production build auth-service",
    "production:build:user": "docker-compose -f docker-compose.production.yml --env-file .env.production build user-service",
    "production:build:shipment": "docker-compose -f docker-compose.production.yml --env-file .env.production build shipment-service",
    "production:build:partner": "docker-compose -f docker-compose.production.yml --env-file .env.production build partner-service",
    "production:build:wallet": "docker-compose -f docker-compose.production.yml --env-file .env.production build wallet-service",
    "production:build:support": "docker-compose -f docker-compose.production.yml --env-file .env.production build support-service",
    "production:build:platform": "docker-compose -f docker-compose.production.yml --env-file .env.production build platform-service",
    "production:build:license": "docker-compose -f docker-compose.production.yml --env-file .env.production build license-service",
    "production:build:backend": "docker-compose -f docker-compose.production.yml --env-file .env.production build api-gateway auth-service user-service shipment-service partner-service wallet-service support-service platform-service license-service",
    "production:build:all": "docker-compose -f docker-compose.production.yml --env-file .env.production build",
    "production:logs:frontend": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f frontend",
    "production:logs:api-gateway": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f api-gateway",
    "production:logs:auth": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f auth-service",
    "production:logs:user": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f user-service",
    "production:logs:shipment": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f shipment-service",
    "production:logs:partner": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f partner-service",
    "production:logs:wallet": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f wallet-service",
    "production:logs:support": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f support-service",
    "production:logs:platform": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f platform-service",
    "production:logs:license": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f license-service",
    "production:logs:backend": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f api-gateway auth-service user-service shipment-service partner-service wallet-service support-service platform-service license-service",
    "production:logs:postgres": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f postgres",
    "production:logs:redis": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f redis",
    "production:logs:infrastructure": "docker-compose -f docker-compose.production.yml --env-file .env.production logs -f postgres redis",
    "cleanup:deep": "./scripts/cleanup.sh --docker-deep-clean",
    "db:init": "./scripts/init-databases.sh",
    "lint:staged": "lint-staged",
    "commit": "git-cz",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "secure:build": "cd tools/secure-docker-builder && npm install && node src/cli.js build",
    "secure:generate-config": "cd tools/secure-docker-builder && npm install && node src/cli.js generate-config",
    "secure:push": "cd tools/secure-docker-builder && node src/cli.js push",
    "secure:run": "cd tools/secure-docker-builder && node src/cli.js run",
    "prisma:license": "docker-compose exec license-service npx prisma migrate dev",
    "prisma:license:deploy": "docker-compose exec license-service npx prisma migrate deploy",
    "prisma:license:studio": "docker-compose exec license-service npx prisma studio",
    "import:pincodes": "docker-compose exec partner-service node scripts/import-pincode-data.js",
    "import:pincodes:prod": "docker-compose -f docker-compose.production.yml --env-file .env.production exec partner-service node backend/partner-service/scripts/import-pincode-data.js",
    "load:pincodes": "docker-compose exec partner-service node scripts/load-pincode-data.js",
    "load:pincodes:prod": "docker-compose -f docker-compose.production.yml --env-file .env.production exec partner-service node backend/partner-service/scripts/load-pincode-data.js",
    "seed:geo": "docker-compose exec partner-service node prisma/seed-geographical-data.js",
    "seed:geo:prod": "docker-compose -f docker-compose.production.yml --env-file .env.production exec partner-service node backend/partner-service/prisma/seed-geographical-data.js",
    "ratelimit:reset": "./scripts/reset-rate-limits.sh",
    "ratelimit:reset:prod": "./scripts/reset-rate-limits.sh --prod"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "commitizen": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.55.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.1.1",
    "prettier-plugin-prisma": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "logistics",
    "microservices",
    "prisma",
    "nextjs",
    "nodejs",
    "india",
    "monorepo",
    "yarn-workspace"
  ],
  "author": "Logistics Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/logistics-aggregator-portal.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/logistics-aggregator-portal/issues"
  },
  "homepage": "https://github.com/your-org/logistics-aggregator-portal#readme",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "backend/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "shared/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.prisma": [
      "prettier --write"
    ]
  }
}
