###############################################################################
#  LOGISTICS AGGREGATOR PORTAL — API PLAYGROUND
#  WebStorm / IntelliJ HTTP Client  ( .rest )
#
#  All requests route THROUGH the API Gateway  ->  {{baseUrl}} = http://localhost:3001
#  Select the "dev" environment (top-right run-config dropdown) before running.
#
#  1) Run "Login" first — it auto-captures {{authToken}} into the environment.
#  2) Every {{...}} auth: bearer request reuses that token automatically.
#  3) Path IDs use env vars: set {{id}} (generic) or {{userId}}/{{partnerId}}/
#     {{clientId}}/{{shipmentId}}/{{licenseId}} in http-client.env.json.
#     WebStorm rejects literal { } in a URL — always use {{...}} variables.
#
#  Env vars live in http-client.env.json  (baseUrl, email, password, ids...)
###############################################################################

@contentType = application/json

###############################################################################
#  >>> START HERE : LOGIN  (captures {{authToken}} + {{refreshToken}})
###############################################################################

# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    if (response.status === 200 && response.body.data) {
        client.global.set("authToken", response.body.data.accessToken);
        client.global.set("refreshToken", response.body.data.refreshToken);
        client.log("Auth token captured for user: " + response.body.data.user.email);
    } else {
        client.log("Login failed - check credentials in http-client.env.json");
    }
%}



