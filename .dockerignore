# Docker ignore file for Logistics Aggregator Portal
# Optimizes Docker builds by excluding unnecessary files

# Git and Version Control
.git/
.gitignore
.gitattributes
.github/

# Documentation and README files
*.md
README*
CHANGELOG*
LICENSE*
CONTRIBUTING*
docs/
wiki/
memory-bank/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node.js and Package Management
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# Package lock files
package-lock.json
pnpm-lock.yaml
**/pnpm-lock.yaml
# Yarn workspace: the ROOT yarn.lock IS needed in the build context so the
# prod Dockerfiles can `COPY package.json yarn.lock ./` and run a frozen
# install. Exclude stray service-level lockfiles, keep the root one.
backend/**/yarn.lock
frontend/yarn.lock
shared/yarn.lock
!/yarn.lock

# Environment and Configuration
.env
.env.*
!.env.example
.envrc

# Build artifacts and output
dist/
build/
out/
.next/
.nuxt/
.output/
.vercel/

# Testing
coverage/
.nyc_output/
test-results/
.coverage/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
tmp/
temp/
.tmp/
.temp/

# Development and tooling
.husky/
# Keep production-entrypoint.sh for Docker builds
# scripts/* exclusion removed - entrypoint scripts needed in containers
.eslintcache
.prettierrc*
.editorconfig
.gitpod.yml
.gitpod.dockerfile

# Docker files (avoid recursion)
Dockerfile*
docker-compose*
.dockerignore

# Database files (for local development)
*.db
*.sqlite
*.sqlite3
data/
volumes/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Prisma generated files (will be generated in container)
**/prisma/client/
**/generated/

# TypeScript build cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# Prettier cache
.prettier-cache

# Webpack/Build caches
.cache/
.parcel-cache/

# Storybook
.storybook/build/
storybook-static/

# Mac system files
**/.DS_Store

# Windows system files
**/Thumbs.db
**/ehthumbs.db
**/Desktop.ini

# Linux system files  
**/.directory

# JetBrains IDEs
**/.idea/
*.iml
*.ipr
*.iws

# VS Code
**/.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim
**/*.swp
**/*.swo
**/*.swn
**/*.bak

# Emacs
**/*~
**/#*#
**/.#*

# Backup files
*.bak
*.backup
*.old
*.orig

# Archive files
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# Certificate files (security)
*.pem
*.key
*.crt
*.cert

# Local configuration override files
*.local
config.local.*
.env.local

# Performance monitoring
.clinic/
.0x/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# nyc test coverage
.nyc_output/

# Dependency directories that should be installed in container
jspm_packages/
bower_components/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.test
.env.production

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test/