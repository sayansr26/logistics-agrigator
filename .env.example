# Environment Configuration
NODE_ENV=development

# Database Configuration
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics123
POSTGRES_DB=logistics_main
DATABASE_URL=postgresql://logistics:logistics123@localhost:5432/logistics_main

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=2592000

# API Gateway
API_GATEWAY_PORT=8000

# Service Ports
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
SHIPMENT_SERVICE_PORT=8003
SUPPORT_SERVICE_PORT=8004
PLATFORM_SERVICE_PORT=8005

# External Services (Existing Microservices)
WALLET_SERVICE_URL=http://localhost:8006
WALLET_SERVICE_API_KEY=your_wallet_service_api_key

PARTNER_SERVICE_URL=http://localhost:8007
PARTNER_SERVICE_API_KEY=your_partner_service_api_key

# Platform Integration
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# Communication Services
SMS_PROVIDER=msg91
MSG91_API_KEY=your_msg91_api_key

EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key

# File Storage
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx,csv,xlsx

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TRACKING_URL=http://localhost:3000/track

# Development
LOG_LEVEL=debug