# ==============================================================================
# LOGISTICS AGGREGATOR PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains all environment variables for the complete project.
# Copy to .env and customize values for your environment.
# 
# 🔧 AUTO-MANAGED: Run `yarn setup:dev` to auto-create .env files for all services
# 📝 UPDATES: Edit this file and run `yarn setup:env` to sync changes to all services

# ==============================================================================
# GENERAL CONFIGURATION
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=debug

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
POSTGRES_USER=logistics
POSTGRES_PASSWORD=logistics123
POSTGRES_DB=logistics_main

# Individual Service Database URLs (Docker Internal Network)
DATABASE_URL_AUTH=postgresql://logistics:logistics123@postgres:5432/logistics_auth
DATABASE_URL_USER=postgresql://logistics:logistics123@postgres:5432/logistics_users
DATABASE_URL_SHIPMENT=postgresql://logistics:logistics123@postgres:5432/logistics_shipments
DATABASE_URL_PARTNER=postgresql://logistics:logistics123@postgres:5432/logistics_partners
DATABASE_URL_WALLET=postgresql://logistics:logistics123@postgres:5432/logistics_wallet
DATABASE_URL_SUPPORT=postgresql://logistics:logistics123@postgres:5432/logistics_support
DATABASE_URL_PLATFORM=postgresql://logistics:logistics123@postgres:5432/logistics_platforms

# Local Database URLs (for direct connection outside Docker)
DATABASE_URL_AUTH_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_auth
DATABASE_URL_USER_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_users
DATABASE_URL_SHIPMENT_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_shipments
DATABASE_URL_PARTNER_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_partners
DATABASE_URL_WALLET_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_wallet
DATABASE_URL_SUPPORT_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_support
DATABASE_URL_PLATFORM_LOCAL=postgresql://logistics:logistics123@localhost:3009/logistics_platforms

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Redis Password (leave empty for no authentication in development)
# IMPORTANT: Set a strong password for production deployments
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:3010

# ==============================================================================
# SERVICE PORTS CONFIGURATION (CORRECTED SEQUENCE)
# ==============================================================================
# External Access Ports
FRONTEND_PORT=3000
API_GATEWAY_PORT=3001
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
SHIPMENT_SERVICE_PORT=3004
PARTNER_SERVICE_PORT=3005
WALLET_SERVICE_PORT=3006
SUPPORT_SERVICE_PORT=3007
PLATFORM_SERVICE_PORT=3008
POSTGRES_PORT=3009
REDIS_PORT=3010

# ==============================================================================
# INTER-SERVICE COMMUNICATION URLs (Docker Internal Network)
# ==============================================================================
API_GATEWAY_URL=http://api-gateway:3001
AUTH_SERVICE_URL=http://auth-service:3002
USER_SERVICE_URL=http://user-service:3003
SHIPMENT_SERVICE_URL=http://shipment-service:3004
PARTNER_SERVICE_URL=http://partner-service:3005
WALLET_SERVICE_URL=http://wallet-service:3006
SUPPORT_SERVICE_URL=http://support-service:3007
PLATFORM_SERVICE_URL=http://platform-service:3008

# Local Service URLs (for external access)
# Change localhost to your server IP for production (e.g., 103.17.193.231)
API_GATEWAY_URL_LOCAL=http://localhost:3001
AUTH_SERVICE_URL_LOCAL=http://localhost:3002
USER_SERVICE_URL_LOCAL=http://localhost:3003
SHIPMENT_SERVICE_URL_LOCAL=http://localhost:3004
PARTNER_SERVICE_URL_LOCAL=http://localhost:3005
WALLET_SERVICE_URL_LOCAL=http://localhost:3006
SUPPORT_SERVICE_URL_LOCAL=http://localhost:3007
PLATFORM_SERVICE_URL_LOCAL=http://localhost:3008

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
# Frontend API URL (used by Next.js)
# Change to http://YOUR_SERVER_IP:3001 for production
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==============================================================================
# JWT & AUTHENTICATION CONFIGURATION
# ==============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-256-bits-required
JWT_EXPIRES_IN=28800
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_ROUNDS=12

# ==============================================================================
# EXTERNAL API INTEGRATIONS
# ==============================================================================

# External Wallet API (Microservice Integration)
EXTERNAL_WALLET_API_URL=https://wapi.websiteduniya.com/api/v1
EXTERNAL_WALLET_SECRET_KEY=production-hmac-secret-key-256-bit-minimum-ultra-secure-change-me
EXTERNAL_WALLET_USER_ID=wallet-service
EXTERNAL_WALLET_JWT_TOKEN=

# External Partner Micro Service (Calculation Engine)
PARTNER_SERVICE_EXTERNAL_URL=https://calc.websiteduniya.com
PARTNER_SERVICE_API_KEY=your_super_secret_hmac_key_minimum_32_characters
EXTERNAL_COURIER_TIMEOUT=15000

# Partner Micro Service Authentication (HMAC SHA-256)
SERVICE_ID=TESTING_1
HMAC_SECRET=hmac_super_secret_key_2024_partner_services
API_SECRET_SALT=api_secret_salt_2024_partner_services
PARTNER_SERVICE_TIMEOUT=5000
PARTNER_SERVICE_RETRY_ATTEMPTS=3
PARTNER_SERVICE_CACHE_TTL=300

# Courier API Integrations (Partner Service)
DELHIVERY_API_URL=https://track.delhivery.com/api/cmu/push/json
DELHIVERY_API_TOKEN=your-delhivery-api-token

BLUEDART_API_URL=https://apigateway.bluedart.com
BLUEDART_API_TOKEN=your-bluedart-api-token

DTDC_API_URL=https://blktracksvc.dtdc.com
DTDC_API_TOKEN=your-dtdc-api-token

ECOM_EXPRESS_API_URL=https://api.ecomexpress.in
ECOM_EXPRESS_API_TOKEN=your-ecom-express-api-token

# ==============================================================================
# RATE LIMITING CONFIGURATION
# ==============================================================================
# General Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Wallet Service Specific Rate Limiting
RATE_LIMIT_STRICT_MAX=50
RATE_LIMIT_BALANCE_MAX=100
RATE_LIMIT_TRANSACTION_MAX=30

# API Gateway (per client IP). TRUST_PROXY_HOPS = number of reverse proxies in
# front of the gateway; it decides which X-Forwarded-For entry becomes req.ip,
# and therefore the rate-limit key. Set 0 if nothing proxies the gateway.
TRUST_PROXY_HOPS=1
RATE_LIMIT_GATEWAY_MAX=5000
RATE_LIMIT_GATEWAY_WINDOW_MS=900000

# Partner service (per user; per client IP for anonymous calls).
# Pincode/geography lookups are the hot path — address forms type-ahead against
# them, so these ceilings are high on purpose. Raise and `make restart` if 429s
# show up again; no rebuild needed.
RATE_LIMIT_GENERAL_MAX=3000          # all partner-service routes / 15 min
RATE_LIMIT_GEO_SEARCH_MAX=1200       # /api/v1/geography/* (pincode lookup) / min
RATE_LIMIT_SERVICEABILITY_MAX=600    # pincode serviceability checks / min
RATE_LIMIT_RATE_CALC_MAX=300         # rate calculation / min
RATE_LIMIT_PINCODE_TYPE_MAX=300      # /api/v1/pincode-types/* / 15 min

# ==============================================================================
# E-COMMERCE PLATFORM INTEGRATIONS
# ==============================================================================
# Shopify Integration
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# WooCommerce Integration (Future)
WOOCOMMERCE_CLIENT_ID=your_woocommerce_client_id
WOOCOMMERCE_CLIENT_SECRET=your_woocommerce_client_secret

# ==============================================================================
# COMMUNICATION SERVICES
# ==============================================================================
# SMS Provider Configuration
SMS_PROVIDER=msg91
MSG91_API_KEY=your_msg91_api_key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=your_sender_id

# Email Provider Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@logistics.com
SENDGRID_FROM_NAME=Logistics Portal

# ==============================================================================
# WALLET & PAYMENT CONFIGURATION
# ==============================================================================
DEFAULT_CLIENT_CODE=DEFAULT
DEFAULT_CURRENCY=INR

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay etc.)
# ------------------------------------------------------------------------------
# IMPORTANT: provider API credentials are NOT configured here.
# Razorpay key id / key secret are entered at runtime by an admin under
# Settings > Payment Providers and stored AES-256-GCM encrypted in the
# wallet-service `payment_provider_configs` table.
#
# PAYMENT_SECRET_ENC_KEY is the key that protects those stored credentials at
# rest. It must be a 32-byte value, hex (64 chars) or base64 encoded:
#   openssl rand -hex 32
# Rotating this key makes every already-stored credential undecryptable - each
# provider's credentials must then be re-entered from Settings.
PAYMENT_SECRET_ENC_KEY=

# Public base URL of the API Gateway. Used to build the webhook URL that is
# registered with the provider: <PAYMENT_PUBLIC_API_URL>/api/v1/wallet/topup/webhook/<provider>
# Must be internet-reachable for provider callbacks to arrive.
PAYMENT_PUBLIC_API_URL=http://localhost:3001

# Frontend URL the customer is returned to after completing/abandoning payment.
PAYMENT_CALLBACK_URL=http://localhost:3000/wallet/topup/callback

# Hours a generated payment link stays valid before it expires.
PAYMENT_LINK_DEFAULT_EXPIRY_HOURS=24

# Maximum simultaneous PENDING top-up orders allowed per wallet.
TOPUP_MAX_OPEN_ORDERS=3

# Background reconciler: polls the provider for orders whose webhook never
# arrived, so a paid top-up is still credited.
TOPUP_RECONCILE_ENABLED=true
TOPUP_RECONCILE_INTERVAL_SEC=120
TOPUP_RECONCILE_MAX_ATTEMPTS=10

# Rate limit for the public webhook endpoint (requests/minute/IP). Sized for
# provider retry storms, not for normal traffic.
RATE_LIMIT_WEBHOOK_MAX=600

# ==============================================================================
# FILE STORAGE & UPLOADS
# ==============================================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx,csv,xlsx,xls
UPLOAD_DESTINATION=uploads
MAX_FILES_PER_REQUEST=10

# AWS S3 Configuration (if using S3 for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=logistics-uploads

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
# Next.js Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_TRACKING_URL=http://localhost:3000/track
NEXT_PUBLIC_SUPPORT_URL=http://localhost:3000/support
NEXT_PUBLIC_APP_NAME=Logistics Aggregator Portal
NEXT_PUBLIC_APP_VERSION=1.0.0

# Frontend Build Configuration
NEXT_BUILD_ANALYZE=false
NEXT_BUILD_OUTPUT=standalone

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Security Headers
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_XSS_PROTECTION=1

# API Security
API_KEY_LENGTH=32
API_RATE_LIMIT_GLOBAL=10000
API_RATE_LIMIT_PER_USER=1000

# ==============================================================================
# MONITORING & LOGGING
# ==============================================================================
# Application Monitoring
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30000
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging Configuration
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_COMPRESS=true

# Error Reporting (Optional - Sentry, Bugsnag, etc.)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=development
ENABLE_ERROR_REPORTING=false

# ==============================================================================
# DEVELOPMENT & TESTING
# ==============================================================================
# Development Tools
ENABLE_DEBUG=true
ENABLE_DEV_TOOLS=true
HOT_RELOAD=true

# Testing Configuration
TEST_DATABASE_URL=postgresql://logistics:logistics123@localhost:3009/logistics_test
TEST_REDIS_URL=redis://localhost:3010/1
RUN_MIGRATIONS_ON_TEST=true

# Development Ports (for tools)
SWAGGER_PORT=8080
PRISMA_STUDIO_PORT=5555
REDIS_COMMANDER_PORT=8081

# ==============================================================================
# PRODUCTION OVERRIDES
# ==============================================================================
# These will be used in production environment
# PRODUCTION_DATABASE_URL=postgresql://user:pass@prod-host:5432/logistics_prod
# PRODUCTION_REDIS_URL=redis://prod-redis-host:6379
# PRODUCTION_JWT_SECRET=ultra-secure-production-jwt-secret-256-bits-minimum
# PRODUCTION_API_URL=https://api.yourlogistics.com
# PRODUCTION_FRONTEND_URL=https://yourlogistics.com

# ==============================================================================
# ENVIRONMENT-SPECIFIC FEATURE FLAGS
# ==============================================================================
ENABLE_ANALYTICS=false
ENABLE_REAL_TIME_TRACKING=true
ENABLE_BULK_OPERATIONS=true
ENABLE_ADVANCED_REPORTING=true
ENABLE_WHITE_LABEL=true
ENABLE_MULTI_TENANT=true

# ============================================
# AI PROVIDER (DeepSeek-compatible)
# ============================================

AI_DEFAULT_PROVIDER=DEEPSEEK
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
AI_ANOMALY_ENABLED=false

# Platform-wide fallback outlet markup (charges-engine v3).
# Used only when an outlet has no defaultMarkupType/defaultMarkupValue of its
# own. Priced as a taxable line inside the quoted subtotal (GST applies).
# Leave TYPE empty to disable the fallback entirely.
# PLATFORM_DEFAULT_MARKUP_TYPE=PERCENTAGE   # FLAT | PERCENTAGE
# PLATFORM_DEFAULT_MARKUP_VALUE=10

# ---------------------------------------------------------------------------
# Supplier identity printed on GST tax invoices (shipment-service).
# Code defaults cover everything except GSTIN, which must be set explicitly
# before invoices are used for real filings.
# ---------------------------------------------------------------------------
# PLATFORM_COMPANY_NAME=SUB Solution
# PLATFORM_GSTIN=07XXXXXXXXXXXZX
# PLATFORM_ADDRESS=401, Pooja Complex, Veer Savarkar Block, Shakarpur, Delhi 110092
# PLATFORM_PHONE=+91 98105 92557
# PLATFORM_EMAIL=support@subsolution.in
