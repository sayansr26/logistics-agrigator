# =============== FRONTEND PRODUCTION DOCKERFILE ===============
# Context: Root of project (has access to workspace files)
# Usage: docker build -f frontend/Dockerfile.prod .
#
# Two stages. The build needs the full workspace install (devDependencies,
# TypeScript, Tailwind) and leaves ~1.4GB of artifacts behind — root
# node_modules, a ~600MB .next/cache, and a second copy of node_modules inside
# the standalone output. None of it is read at runtime: the container has always
# run `node frontend/server.js` from .next/standalone. Shipping the builder
# stage as the final image meant pulling ~1.6GB to serve ~34MB.

# ---------------------------------------------------------------- build stage
FROM node:20-alpine AS builder
WORKDIR /app

# Same non-root user as the runtime stage: `yarn build` writes .next as this
# user, so the files COPY'd out below are already owned correctly.
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Copy workspace files (needed for yarn to resolve dependencies)
COPY --chown=nodejs:nodejs package.json yarn.lock ./
COPY --chown=nodejs:nodejs shared/package.json ./shared/package.json
COPY --chown=nodejs:nodejs frontend/package.json ./frontend/

# Install all workspace dependencies
RUN yarn install --frozen-lockfile

# Copy shared and frontend source
COPY --chown=nodejs:nodejs shared ./shared
COPY --chown=nodejs:nodejs frontend ./frontend

# Build frontend
USER nodejs
RUN cd /app/frontend && yarn build

# -------------------------------------------------------------- runtime stage
# With experimental.outputFileTracingRoot set to the monorepo root, Next emits
# the monorepo standalone layout:
#   .next/standalone/frontend/server.js   <-- entrypoint (run from standalone root)
#   .next/standalone/node_modules/        <-- complete traced deps (incl. styled-jsx)
# Static assets are NOT bundled into standalone and must be copied next to the
# server: static to .next/standalone/frontend/.next/static, public to
# .next/standalone/frontend/public.
FROM node:20-alpine
WORKDIR /app

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# The traced server plus its node_modules — the only code that actually runs.
# Paths are kept identical to the previous single-stage image so WORKDIR and CMD
# below are unchanged.
COPY --from=builder --chown=nodejs:nodejs /app/frontend/.next/standalone ./frontend/.next/standalone

# CRITICAL: static assets sit next to the standalone server, not inside it.
# Without these the site serves unstyled with broken images.
COPY --from=builder --chown=nodejs:nodejs /app/frontend/.next/static ./frontend/.next/standalone/frontend/.next/static
COPY --from=builder --chown=nodejs:nodejs /app/frontend/public ./frontend/.next/standalone/frontend/public

USER nodejs
WORKDIR /app/frontend/.next/standalone

EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production

CMD ["node", "frontend/server.js"]
