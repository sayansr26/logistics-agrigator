# =============== FRONTEND PRODUCTION DOCKERFILE ===============
# Context: Root of project (has access to workspace files)
# Usage: docker build -f frontend/Dockerfile.prod .

FROM node:20-alpine
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Copy workspace files (needed for yarn to resolve dependencies)
COPY --chown=nodejs:nodejs package.json yarn.lock ./
COPY --chown=nodejs:nodejs shared/package.json ./shared/package.json
COPY --chown=nodejs:nodejs frontend/package.json ./frontend/

# Install all workspace dependencies
RUN yarn install --frozen-lockfile

# Copy shared and frontend source
COPY --chown=nodejs:nodejs shared ./shared
COPY --chown=nodejs:nodejs frontend ./frontend

# Build frontend
USER nodejs
RUN cd /app/frontend && yarn build

# =============== PRODUCTION RUNTIME SETUP ===============
# With experimental.outputFileTracingRoot set to the monorepo root, Next emits
# the monorepo standalone layout:
#   .next/standalone/frontend/server.js   <-- entrypoint (run from standalone root)
#   .next/standalone/node_modules/        <-- complete traced deps (incl. styled-jsx)
# Static assets are not bundled in standalone and must be copied to
# .next/standalone/frontend/.next/static; public to .next/standalone/frontend/public.
USER root

# CRITICAL: Copy static assets next to the standalone server
RUN mkdir -p /app/frontend/.next/standalone/frontend/.next && \
    cp -r /app/frontend/.next/static /app/frontend/.next/standalone/frontend/.next/static

# Copy public assets (if exists - some projects don't have public folder)
RUN if [ -d "/app/frontend/public" ]; then \
        cp -r /app/frontend/public /app/frontend/.next/standalone/frontend/public; \
    fi

# Set ownership
RUN chown -R nodejs:nodejs /app

# Run from the standalone root; the server entry is frontend/server.js
USER nodejs
WORKDIR /app/frontend/.next/standalone

EXPOSE 3000

ENV PORT 3000
ENV NODE_ENV production

CMD ["node", "frontend/server.js"]
