# Frontend Environment Configuration
# Copy this file to .env.local and update the values

# API Base URL (Auth Service)
NEXT_PUBLIC_API_BASE_URL=http://103.17.193.231:3002

# Alternative API URLs for different services
NEXT_PUBLIC_USER_SERVICE_URL=http://103.17.193.231:3003
NEXT_PUBLIC_PARTNER_SERVICE_URL=http://103.17.193.231:3005
NEXT_PUBLIC_SHIPMENT_SERVICE_URL=http://103.17.193.231:3004
NEXT_PUBLIC_WALLET_SERVICE_URL=http://103.17.193.231:3006
NEXT_PUBLIC_PLATFORM_SERVICE_URL=http://103.17.193.231:3007

# Feature Flags
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Development Settings
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug
