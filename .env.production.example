# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to git!
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Docker Compose project name (isolates PROD from UAT/dev containers)
COMPOSE_PROJECT_NAME=logistics-prod
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# REGISTRY / IMAGE TAG (pull-only deploy — docker-compose.production.yml)
# ============================================================================
# Images are built+pushed from the Mac (`make release-prod`) and pulled by
# `make deploy`. IMAGE_TAG selects which tag runs; set to a git short-sha for
# rollbacks (requires releasing with VERSION=<sha>).
REGISTRY=ghcr.io/sayansr26
IMAGE_TAG=prod

# ============================================================================
# DATABASE (Use STRONG passwords - generate with: openssl rand -base64 32)
# ============================================================================
POSTGRES_USER=logistics
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=logistics_main
DB_PORT=5432

# Database Names
AUTH_DATABASE_NAME=logistics_auth
USER_DATABASE_NAME=logistics_users
SHIPMENT_DATABASE_NAME=logistics_shipments
PARTNER_DATABASE_NAME=logistics_partners
WALLET_DATABASE_NAME=logistics_wallet
SUPPORT_DATABASE_NAME=logistics_support
PLATFORM_DATABASE_NAME=logistics_platforms
LICENSE_DATABASE_NAME=logistics_license

# ============================================================================
# REDIS
# ============================================================================
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================================================
# SERVICE PORTS (Same as development)
# ============================================================================
FRONTEND_PORT=3000
API_GATEWAY_PORT=3001
AUTH_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
SHIPMENT_SERVICE_PORT=3004
PARTNER_SERVICE_PORT=3005
WALLET_SERVICE_PORT=3006
SUPPORT_SERVICE_PORT=3007
PLATFORM_SERVICE_PORT=3008
LICENSE_SERVICE_PORT=3009

# Published HOST ports for the externally-reachable services. Only these must
# differ between PROD and UAT on the same host (UAT uses 4000/4001).
API_GATEWAY_HOST_PORT=3001
FRONTEND_HOST_PORT=3000

# Container Names (Optional - override defaults)
# POSTGRES_CONTAINER_NAME=logistics-postgres-prod
# REDIS_CONTAINER_NAME=logistics-redis-prod
# API_GATEWAY_CONTAINER_NAME=logistics-api-gateway-prod
# AUTH_SERVICE_CONTAINER_NAME=logistics-auth-service-prod
# USER_SERVICE_CONTAINER_NAME=logistics-user-service-prod
# SHIPMENT_SERVICE_CONTAINER_NAME=logistics-shipment-service-prod
# PARTNER_SERVICE_CONTAINER_NAME=logistics-partner-service-prod
# WALLET_SERVICE_CONTAINER_NAME=logistics-wallet-service-prod
# SUPPORT_SERVICE_CONTAINER_NAME=logistics-support-service-prod
# PLATFORM_SERVICE_CONTAINER_NAME=logistics-platform-service-prod
# LICENSE_SERVICE_CONTAINER_NAME=logistics-license-service-prod
# FRONTEND_CONTAINER_NAME=logistics-frontend-prod

# ============================================================================
# JWT (Generate with: openssl rand -hex 32)
# ============================================================================
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=604800
INTERNAL_SECRET=CHANGE_ME_ANOTHER_STRONG_SECRET_HERE
# Quote token signing (openssl rand -hex 32) - REQUIRED by shipment-service /quotes
QUOTE_SIGNING_SECRET=CHANGE_ME_QUOTE_SIGNING_SECRET_MINIMUM_32_CHARACTERS

# ============================================================================
# CORS (Production domains only - comma separated)
# ============================================================================
CROSS_ORIGIN=https://yourdomain.com
DEVELOPMENT_ORIGINS=http://localhost:3000
PRODUCTION_ORIGINS=https://yourdomain.com
STAGING_ORIGINS=https://staging.yourdomain.com

# ============================================================================
# FRONTEND
# ============================================================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_ENV=production

# ============================================================================
# EXTERNAL APIs
# ============================================================================
EXTERNAL_WALLET_API_URL=https://wapi.websiteduniya.com/api/v1
EXTERNAL_WALLET_SECRET_KEY=YOUR_WALLET_SECRET_KEY
EXTERNAL_WALLET_USER_ID=YOUR_WALLET_USER_ID
EXTERNAL_WALLET_JWT_TOKEN=

PARTNER_SERVICE_EXTERNAL_URL=https://calc.websiteduniya.com
PARTNER_SERVICE_API_KEY=YOUR_PARTNER_API_KEY
SERVICE_ID=YOUR_SERVICE_ID
HMAC_SECRET=YOUR_HMAC_SECRET
API_SECRET_SALT=YOUR_API_SECRET_SALT

DELHIVERY_API_URL=https://track.delhivery.com/api/cmu/push/json
DELHIVERY_API_TOKEN=YOUR_DELHIVERY_TOKEN
BLUEDART_API_URL=https://apigateway.bluedart.com
BLUEDART_API_TOKEN=YOUR_BLUEDART_TOKEN

# ============================================================================
# WALLET SERVICE
# ============================================================================
WALLET_JWT_EXPIRES_IN=8h
WALLET_JWT_REFRESH_EXPIRES_IN=2592000
WALLET_DEFAULT_CLIENT_CODE=DEFAULT

# ============================================================================
# CACHE SETTINGS
# ============================================================================
CACHE_WALLET_TTL=600
CACHE_BALANCE_TTL=300
CACHE_TRANSACTIONS_TTL=60

# ============================================================================
# CIRCUIT BREAKER
# ============================================================================
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_STRICT_MAX=50
RATE_LIMIT_BALANCE_MAX=100
RATE_LIMIT_TRANSACTION_MAX=30

# ============================================================================
# LICENSE SERVICE
# ============================================================================
LICENSE_SECRET_KEY=YOUR_LICENSE_SECRET_KEY
LICENSE_SIGNING_KEY=YOUR_LICENSE_SIGNING_KEY
LICENSE_JWT_EXPIRES_IN=8h
LICENSE_JWT_REFRESH_EXPIRES_IN=604800

# ============================================================================
# SHOPIFY
# ============================================================================
SHOPIFY_CLIENT_ID=YOUR_SHOPIFY_CLIENT_ID
SHOPIFY_CLIENT_SECRET=YOUR_SHOPIFY_CLIENT_SECRET

# ============================================================================
# SERVICE NAMES
# ============================================================================
SERVICE_NAME=api-gateway
SHIPMENT_SERVICE_NAME=shipment-service
SUPPORT_SERVICE_NAME=support-service
PLATFORM_SERVICE_NAME=platform-service
LICENSE_SERVICE_NAME=license-service

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
DEPLOY_PATH=/var/www/sub-solution
SERVER_HOST=103.17.193.231
SERVER_USER=gitlab-runner
SERVER_PORT=22

# ============================================================================
# OPTIONAL: NOTIFICATION WEBHOOKS
# ============================================================================
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================
# LOG_LEVEL=info
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-newrelic-key

# ============================================================================
# NOTES:
# ============================================================================
# 1. Generate strong passwords using:
#    openssl rand -base64 32
#
# 2. Generate JWT secrets using:
#    openssl rand -hex 32
#
# 3. Keep backups of this file in a secure location
#
# 4. For GitLab CI/CD, add these as CI/CD variables:
#    Settings → CI/CD → Variables
#
# 5. Regularly rotate secrets (every 90 days recommended)
#
# 6. Use different credentials for production vs staging
# ============================================================================

# ============================================
# AI PROVIDER (DeepSeek-compatible)
# ============================================

AI_DEFAULT_PROVIDER=DEEPSEEK
AI_API_KEY=your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
AI_ANOMALY_ENABLED=false

# Platform-wide fallback outlet markup (charges-engine v3).
# Used only when an outlet has no defaultMarkupType/defaultMarkupValue of its
# own. Priced as a taxable line inside the quoted subtotal (GST applies).
# Leave TYPE empty to disable the fallback entirely.
# PLATFORM_DEFAULT_MARKUP_TYPE=PERCENTAGE   # FLAT | PERCENTAGE
# PLATFORM_DEFAULT_MARKUP_VALUE=10
