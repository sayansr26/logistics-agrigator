# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.production and fill in the actual values
# NEVER commit .env.production to git!
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_USER=logistics
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=logistics_main
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=604800

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Production domains only (comma-separated)
CORS_ORIGIN=https://yourdomain.com,https://api.yourdomain.com

# ============================================================================
# EXTERNAL API CONFIGURATION
# ============================================================================

# Partner Micro Service
PARTNER_SERVICE_EXTERNAL_URL=https://calc.websiteduniya.com
PARTNER_SERVICE_ID=YOUR_SERVICE_ID_HERE
PARTNER_HMAC_SECRET=YOUR_HMAC_SECRET_HERE
PARTNER_API_SECRET_SALT=YOUR_API_SECRET_SALT_HERE

# External Wallet API
EXTERNAL_WALLET_API_URL=https://wapi.websiteduniya.com/api/v1
EXTERNAL_WALLET_SECRET_KEY=YOUR_WALLET_SECRET_KEY_HERE
EXTERNAL_WALLET_USER_ID=YOUR_WALLET_USER_ID_HERE

# ============================================================================
# SHOPIFY INTEGRATION (Platform Service)
# ============================================================================
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_ENV=production

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3000

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
DEPLOY_PATH=/var/www/sub-solution
SERVER_HOST=103.17.193.231
SERVER_USER=gitlab-runner
SERVER_PORT=22

# ============================================================================
# OPTIONAL: NOTIFICATION WEBHOOKS
# ============================================================================
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================
# LOG_LEVEL=info
# SENTRY_DSN=https://your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-newrelic-key

# ============================================================================
# NOTES:
# ============================================================================
# 1. Generate strong passwords using:
#    openssl rand -base64 32
#
# 2. Generate JWT secrets using:
#    openssl rand -hex 32
#
# 3. Keep backups of this file in a secure location
#
# 4. For GitLab CI/CD, add these as CI/CD variables:
#    Settings → CI/CD → Variables
#
# 5. Regularly rotate secrets (every 90 days recommended)
#
# 6. Use different credentials for production vs staging
# ============================================================================
