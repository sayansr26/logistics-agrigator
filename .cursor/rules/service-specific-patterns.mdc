### **Auto-Assignment Logic**

```javascript
// services/ticketService.js
class TicketService {
  static async createTicket(ticketData, userId) {
    try {
      // Generate ticket number
      const ticketNumber = await this.generateTicketNumber();

      // Auto-assign if enabled
      let assignedTo = null;
      if (process.env.AUTO_ASSIGN_TICKETS === "true") {
        assignedTo = await this.findAvailableAgent(ticketData.category);
      }

      const ticket = await prisma.ticket.create({
        data: {
          ...ticketData,
          ticketNumber,
          userId,
          assignedTo,
          assignedAt: assignedTo ? new Date() : null,
        },
        include: {
          messages: true,
          attachments: true,
        },
      });

      // Schedule escalation if needed
      if (ticket.priority === "HIGH" || ticket.priority === "URGENT") {
        await this.scheduleEscalation(ticket.id);
      }

      // Send notification to assigned agent
      if (assignedTo) {
        await this.notifyAgent(assignedTo, ticket);
      }

      return ticket;
    } catch (error) {
      console.error("Ticket creation error:", error);
      throw error;
    }
  }

  static async scheduleEscalation(ticketId) {
    const escalationTime =
      parseInt(process.env.TICKET_ESCALATION_TIME) || 86400; // 24 hours

    // This would typically use a job queue like Bull or Agenda
    setTimeout(async () => {
      await this.escalateTicket(ticketId);
    }, escalationTime * 1000);
  }
}
```

## **Platform Service Implementation Patterns**

### **Core Responsibilities**

- E-commerce platform integrations (Shopify, Amazon, etc.)
- Order synchronization
- Webhook handling
- Platform-specific API management

### **Specific Schema Patterns**

```prisma
// Platform Service Schema
model PlatformIntegration {
  id           String          @id @default(cuid())
  userId       String          // From user service
  clientId     String?         // Multi-tenant support
  platform     PlatformType

  // Credentials (encrypted)
  credentials  Json            // Platform-specific credentials

  // Configuration
  isActive     Boolean         @default(true)
  syncEnabled  Boolean         @default(true)
  lastSyncAt   DateTime?

  // Metadata
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relationships
  syncLogs     PlatformSyncLog[]
  webhooks     PlatformWebhook[]

  @@map("platform_integrations")
}

model PlatformSyncLog {
  id            String              @id @default(cuid())
  integrationId String
  syncType      SyncType
  status        SyncStatus
  recordsProcessed Int              @default(0)
  recordsSuccess   Int              @default(0)
  recordsError     Int              @default(0)
  errorDetails  Json?
  startedAt     DateTime            @default(now())
  completedAt   DateTime?

  // Relationships
  integration   PlatformIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@map("platform_sync_logs")
}

enum PlatformType {
  SHOPIFY
  AMAZON
  WOOCOMMERCE
  MAGENTO
  CUSTOM
}

enum SyncType {
  ORDERS
  PRODUCTS
  CUSTOMERS
  INVENTORY
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
