### **Shopify Integration Pattern**

```javascript
// services/shopifyService.js
class ShopifyService {
  constructor(credentials) {
    this.clientId = credentials.clientId;
    this.clientSecret = credentials.clientSecret;
    this.accessToken = credentials.accessToken;
    this.shopDomain = credentials.shopDomain;
    this.apiVersion = process.env.SHOPIFY_API_VERSION || "2024-01";
  }

  async syncOrders(integrationId, lastSyncDate = null) {
    try {
      const syncLog = await prisma.platformSyncLog.create({
        data: {
          integrationId,
          syncType: "ORDERS",
          status: "RUNNING",
        },
      });

      let orders = [];
      let hasNextPage = true;
      let cursor = null;

      while (hasNextPage) {
        const response = await this.fetchOrders(cursor, lastSyncDate);
        orders = orders.concat(response.orders);

        hasNextPage = response.pageInfo.hasNextPage;
        cursor = response.pageInfo.endCursor;
      }

      // Process orders
      let successCount = 0;
      let errorCount = 0;
      const errors = [];

      for (const order of orders) {
        try {
          await this.processOrder(order, integrationId);
          successCount++;
        } catch (error) {
          errorCount++;
          errors.push({
            orderId: order.id,
            error: error.message,
          });
        }
      }

      // Update sync log
      await prisma.platformSyncLog.update({
        where: { id: syncLog.id },
        data: {
          status: errorCount > 0 ? "COMPLETED" : "COMPLETED",
          recordsProcessed: orders.length,
          recordsSuccess: successCount,
          recordsError: errorCount,
          errorDetails: errors.length > 0 ? { errors } : null,
          completedAt: new Date(),
        },
      });

      return {
        processed: orders.length,
        success: successCount,
        errors: errorCount,
      };
    } catch (error) {
      console.error("Shopify sync error:", error);

      // Update sync log with error
      await prisma.platformSyncLog.update({
        where: { id: syncLog.id },
        data: {
          status: "FAILED",
          errorDetails: { error: error.message },
          completedAt: new Date(),
        },
      });

      throw error;
    }
  }

  async handleWebhook(webhookData, integrationId) {
    try {
      // Verify webhook signature
      const isValid = this.verifyWebhookSignature(webhookData);
      if (!isValid) {
        throw new Error("Invalid webhook signature");
      }

      // Process webhook based on topic
      switch (webhookData.topic) {
        case "orders/create":
          await this.processOrder(webhookData.data, integrationId);
          break;
        case "orders/updated":
          await this.updateOrder(webhookData.data, integrationId);
          break;
        case "orders/cancelled":
          await this.cancelOrder(webhookData.data, integrationId);
          break;
        default:
          console.log(`Unhandled webhook topic: ${webhookData.topic}`);
      }

      // Log webhook processing
      await prisma.platformWebhook.create({
        data: {
          integrationId,
          topic: webhookData.topic,
          status: "PROCESSED",
          payload: webhookData.data,
        },
      });
    } catch (error) {
      console.error("Webhook processing error:", error);

      // Log webhook error
      await prisma.platformWebhook.create({
        data: {
          integrationId,
          topic: webhookData.topic || "unknown",
          status: "FAILED",
          payload: webhookData.data,
          error: error.message,
        },
      });

      throw error;
    }
  }
}
```

