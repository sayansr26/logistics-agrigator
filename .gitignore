# Logistics Aggregator Portal - Global .gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
# Yarn workspaces: keep the ROOT yarn.lock (tracked), ignore stray
# service-level lockfiles — only the root lockfile governs the workspace.
backend/**/yarn.lock
frontend/yarn.lock
shared/yarn.lock
# Legacy pnpm lockfiles (repo migrated off pnpm) — ignore any that reappear.
pnpm-lock.yaml
**/pnpm-lock.yaml
.pnpm-store/
**/.pnpm-store/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.uat

# Production builds
dist/
build/
out/

# Next.js
.next/
.vercel/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov
.nyc_output/

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Redis dump file
dump.rdb

# Docker
.docker/
docker-compose.override.yml

# Prisma
# Keep schema.prisma and migrations
# Ignore generated client and shadow database
**/**/prisma/generated/
**/**/prisma/migrations/migration_lock.toml
**/**/prisma/migrations/**/migration.sql.bak

# IDE and editor files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
test-results/
coverage/
.nyc_output/
junit.xml

# Miscellaneous
*.tgz
*.tar.gz
.eslintcache
.parcel-cache/
.cache/

# Local development
.local/
.tmp/

# Backup files
*.backup
*.backup-*
*.bak
*.tmp
*.archived
**/docker-compose*.backup-*
docker-compose.*.archived

# Certificate files (for local SSL development)
*.pem
*.key
*.crt
*.cert

# Service-specific ignores
backend/**/.env
backend/*/shared/
frontend/.env*
!frontend/.env.example

# Documentation builds (if using static site generators)
docs/build/
docs/dist/

# Monitoring and metrics
metrics/
monitoring/

# Uploads and user content
uploads/
static/uploads/
public/uploads/

# Generated API documentation
api-docs/generated/


# keep graph outputs, skip heavy/local-only files ( graphify )
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json