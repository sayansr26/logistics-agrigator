# =============== PRODUCTION DOCKERFILE ===============
FROM node:18-alpine

WORKDIR /app

RUN apk add --no-cache openssl
RUN npm install -g pnpm@8.15.1

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY shared ./shared
COPY backend/partner-service/package.json ./backend/partner-service/

RUN cd backend/partner-service && pnpm install --prod --frozen-lockfile --ignore-scripts

COPY backend/partner-service ./backend/partner-service

# Copy shared into service directory for relative imports
RUN cp -r /app/shared /app/backend/partner-service/
RUN cd backend/partner-service && npx prisma generate

# Copy production entrypoint script for automated migrations
COPY --chown=nodejs:nodejs scripts/production-entrypoint.sh /app/production-entrypoint.sh
RUN chmod +x /app/production-entrypoint.sh

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
RUN mkdir -p /app/logs/partner-service && chown -R nodejs:nodejs /app/logs
RUN chown -R nodejs:nodejs /app

USER nodejs
WORKDIR /app

EXPOSE 3005

ENV NODE_ENV=production
ENV PORT=3005
ENV SERVICE_NAME=partner-service

ENTRYPOINT ["/app/production-entrypoint.sh"]
CMD ["node", "backend/partner-service/server.js"]
