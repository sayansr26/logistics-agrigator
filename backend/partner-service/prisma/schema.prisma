// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// PARTNER CHANNEL MANAGEMENT
// ========================================

enum ChannelMode {
  SINGLE
  MULTI
}

model Partner {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique // e.g., "DELHIVERY", "BLUEDART"
  displayName String // e.g., "Delhivery", "Blue Dart"
  isActive    Boolean @default(true)

  // Channel Mode (Single/Multi API endpoints)
  channelMode ChannelMode @default(SINGLE) @map("channel_mode")

  // API Configuration (kept for backward compatibility)
  apiUrl     String
  apiToken   String?
  apiVersion String?

  // Service Configuration
  supportsCOD     Boolean @default(false)
  supportsReverse Boolean @default(false)
  minWeight       Float? // in kg (minimum weight accepted)
  maxWeight       Float? // in kg (maximum weight accepted)
  maxDimensions   Json? // {length, width, height} in cm

  // Pricing Configuration
  baseRate         Float?
  perKgRate        Float?
  codChargePercent Float?
  fuelSurcharge    Float?

  // Delivery Configuration
  defaultDeliveryDays Int? @map("default_delivery_days") // Default delivery days for this partner

  // Service Areas
  servicePincodes String[] // Array of supported pincodes

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments           PartnerShipment[]
  rates               PartnerRate[]
  serviceabilityCache ServiceabilityCache[]
  channelConfigs      PartnerChannelConfig[]
  chargesTypes        ChargesType[]
  pincodeAssigns      PartnerPincodeAssign[]
  chargeRules         ChargeRule[]
  discountPackages    ChargeDiscountPackage[]

  @@index([isActive])
  @@map("partners")
}

model PartnerChannelConfig {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") // CUID to match Partner.id type
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Channel Configuration
  channelName String @map("channel_name") @db.VarChar(100) // e.g., "production", "staging"
  apiUrl      String @map("api_url") @db.VarChar(500)
  apiKey      String @map("api_key") @db.VarChar(500)

  // Channel Settings
  isActive  Boolean @default(true) @map("is_active")
  isPrimary Boolean @default(false) @map("is_primary")
  priority  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([partnerId, channelName])
  @@index([partnerId, isActive])
  @@index([partnerId, isPrimary])
  @@map("partner_channel_configs")
}

model PartnerRate {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Zone Configuration
  fromPincode String
  toPincode   String
  zone        String? // A, B, C, D, E zones

  // Weight Slabs
  minWeight Float // in kg
  maxWeight Float // in kg

  // Pricing
  rate          Float
  codCharge     Float?
  fuelSurcharge Float?

  // Service Type
  serviceType String // SURFACE, AIR, EXPRESS

  // Delivery Time
  deliveryDays Int?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, fromPincode, toPincode, minWeight, maxWeight, serviceType])
  @@map("partner_rates")
}

model PartnerShipment {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  // Shipment Reference
  shipmentId   String  @unique // Reference to main shipment
  partnerAwbNo String? @unique // Partner's AWB number

  // Tracking
  status      String // BOOKED, PICKED, IN_TRANSIT, DELIVERED, RTO, etc.
  trackingUrl String?

  // Charges
  calculatedRate Float?
  actualRate     Float?
  codAmount      Float?

  // Service Details
  serviceType      String // SURFACE, AIR, EXPRESS
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  // Pickup/Delivery
  pickupDate   DateTime?
  deliveryDate DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_shipments")
}

model ServiceabilityCache {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  fromPincode String
  toPincode   String

  isServiceable Boolean
  serviceType   String? // SURFACE, AIR, EXPRESS
  deliveryDays  Int?

  // Cache metadata
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([partnerId, fromPincode, toPincode])
  @@map("serviceability_cache")
}

model AuditLog {
  id String @id @default(cuid())

  // Action Details
  action       String // RATE_CALCULATED, SHIPMENT_BOOKED, STATUS_UPDATED
  resourceType String // PARTNER, SHIPMENT, RATE
  resourceId   String?

  // User Context
  userId    String?
  ipAddress String?
  userAgent String?

  // Request/Response Data
  requestData  Json?
  responseData Json?

  // Error Information
  errorCode    String?
  errorMessage String?

  // Metadata
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

// ========================================
// GEOGRAPHICAL HIERARCHY MODELS
// ========================================

model State {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cities     City[]
  pincodes   Pincode[]
  zoneStates ZoneState[]

  @@index([code, status])
  @@map("states")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  state      State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas      Area[]
  zoneCities ZoneCity[]

  @@index([stateId, status])
  @@index([code])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  pincodes  Pincode[]
  zoneAreas ZoneArea[]

  @@index([cityId, status])
  @@index([code])
  @@map("areas")
}

model Pincode {
  id             String   @id @default(uuid()) @db.Uuid
  areaId         String?  @db.Uuid
  stateId        String   @db.Uuid
  code           String   @unique @db.VarChar(6)
  areaName       String?  @db.VarChar(255)
  district       String?  @db.VarChar(255)
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  odaApplicable  Boolean  @default(false)
  hillApplicable Boolean  @default(false)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  area           Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  state          State                  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zonePincodes   ZonePincode[]
  partnerAssigns PartnerPincodeAssign[]

  @@index([code, status])
  @@index([areaId, status])
  @@index([stateId, status])
  @@index([latitude, longitude])
  @@map("pincodes")
}

// ========================================
// ZONE MANAGEMENT MODELS
// ========================================

// Zone type enum for distinguishing distance-based vs geological zones
enum ZoneType {
  DISTANCE
  GEOLOGICAL
}

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  partnerId   String // Reference to Partner model (keeping CUID for compatibility)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  zoneType    ZoneType @default(GEOLOGICAL) @map("zone_type")
  status      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  zoneStates   ZoneState[]
  zoneCities   ZoneCity[]
  zoneAreas    ZoneArea[]
  zonePincodes ZonePincode[]
  milestones   ZoneMilestone[]

  @@unique([partnerId, name])
  @@index([partnerId, status])
  @@index([zoneType])
  @@map("zones")
}

model ZoneState {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  stateId   String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([zoneId, stateId])
  @@index([zoneId])
  @@index([stateId])
  @@map("zone_states")
}

model ZoneCity {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  cityId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([zoneId, cityId])
  @@index([zoneId])
  @@index([cityId])
  @@map("zone_cities")
}

model ZoneArea {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  areaId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([zoneId, areaId])
  @@index([zoneId])
  @@index([areaId])
  @@map("zone_areas")
}

model ZonePincode {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  pincodeId String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pincode Pincode @relation(fields: [pincodeId], references: [id], onDelete: Cascade)

  @@unique([zoneId, pincodeId])
  @@index([zoneId])
  @@index([pincodeId])
  @@map("zone_pincodes")
}

// ========================================
// ZONE MILESTONE CONFIGURATION (Distance Zones)
// ========================================

model ZoneMilestone {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  minKm     Int      @map("min_km")
  maxKm     Int      @map("max_km")
  suffix    String   @db.VarChar(5) // A, B, C, etc.
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  zone        Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  chargeRules ChargeRule[]

  @@unique([zoneId, sortOrder])
  @@unique([zoneId, minKm])
  @@unique([zoneId, maxKm])
  @@index([zoneId])
  @@map("zone_milestones")
}

// ========================================
// PINCODE TYPE MANAGEMENT
// Simplified: Only type definitions, no assignments or service charges
// ========================================

model PincodeType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  type      String   @db.VarChar(20) // "yes_no" or "number"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partnerValues PartnerPincodeTypeValue[]
  chargeRules   ChargeRule[]

  @@index([isActive, type])
  @@map("pincode_types")
}

// ========================================
// CHARGES TYPE MANAGEMENT
// Partner-specific charge types (e.g., COD, Freight, RTO)
// ========================================

model ChargesType {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id") // CUID to match Partner.id
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  chargeRules ChargeRule[]

  @@unique([partnerId, name]) // Each partner can't have duplicate charge type names
  @@index([partnerId, isActive])
  @@map("charges_types")
}

// ========================================
// PARTNER PINCODE ASSIGNMENT
// ========================================

model PartnerPincodeAssign {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id") // CUID to match Partner.id
  pincodeId String   @map("pincode_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partner           Partner                   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pincode           Pincode                   @relation(fields: [pincodeId], references: [id], onDelete: Cascade)
  pincodeTypeValues PartnerPincodeTypeValue[]

  @@unique([partnerId, pincodeId])
  @@index([partnerId, isActive])
  @@index([pincodeId])
  @@map("partner_pincode_assigns")
}

model PartnerPincodeTypeValue {
  id               String   @id @default(uuid()) @db.Uuid
  partnerPincodeId String   @map("partner_pincode_id") @db.Uuid
  pincodeTypeId    String   @map("pincode_type_id") @db.Uuid
  value            String   @db.VarChar(255) // "yes"/"no" for yes_no, number for number
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  partnerPincode PartnerPincodeAssign @relation(fields: [partnerPincodeId], references: [id], onDelete: Cascade)
  pincodeType    PincodeType          @relation(fields: [pincodeTypeId], references: [id], onDelete: Cascade)

  @@unique([partnerPincodeId, pincodeTypeId])
  @@index([partnerPincodeId])
  @@index([pincodeTypeId])
  @@map("partner_pincode_type_values")
}

// ========================================
// CHARGE RULE MANAGEMENT (Charges Engine)
// ========================================

enum ChargeRuleBase {
  INVOICE_VALUE
  WEIGHT
  ZONE_TO_ZONE_WEIGHT
  DISTANCE_BASE_WEIGHT
}

model ChargeRule {
  id        String         @id @default(uuid()) @db.Uuid
  partnerId String         @map("partner_id") // CUID to match Partner.id
  base      ChargeRuleBase

  // Link to partner's ChargesType (for INVOICE_VALUE/WEIGHT when "Charges Types" selected)
  chargesTypeId String? @map("charges_type_id") @db.Uuid

  // Link to PincodeType (for INVOICE_VALUE/WEIGHT when "Pincode Types" selected)
  pincodeTypeId String? @map("pincode_type_id") @db.Uuid

  // ---- Shared min value (all bases) ----
  minValue Decimal? @map("min_value") @db.Decimal(12, 2)

  // ---- For INVOICE_VALUE base ----
  percentageValue Decimal? @map("percentage_value") @db.Decimal(10, 4)

  // ---- For WEIGHT / ZONE_TO_ZONE_WEIGHT / DISTANCE_BASE_WEIGHT ----
  perKg       Decimal? @map("per_kg") @db.Decimal(10, 3)
  perKgCharge Decimal? @map("per_kg_charge") @db.Decimal(12, 2)

  // ---- For ZONE_TO_ZONE_WEIGHT ----
  fromZoneId String? @map("from_zone_id") @db.Uuid
  toZoneId   String? @map("to_zone_id") @db.Uuid

  // ---- For DISTANCE_BASE_WEIGHT ----
  zoneMilestoneId String? @map("zone_milestone_id") @db.Uuid

  // Status and timestamps
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  chargesType   ChargesType?   @relation(fields: [chargesTypeId], references: [id], onDelete: SetNull)
  pincodeType   PincodeType?   @relation(fields: [pincodeTypeId], references: [id], onDelete: SetNull)
  zoneMilestone ZoneMilestone? @relation(fields: [zoneMilestoneId], references: [id], onDelete: SetNull)

  // Relations to discount items
  discountItems ChargeDiscountPackageItem[]

  @@index([partnerId, base, isActive])
  @@index([partnerId, chargesTypeId, base, isActive])
  @@index([partnerId, pincodeTypeId, isActive])
  @@index([partnerId, zoneMilestoneId, isActive])
  @@map("charge_rules")
}

// ========================================
// CHARGE DISCOUNT PACKAGE MANAGEMENT
// Badge-based discount packages for outlet tiers
// ========================================

enum DiscountType {
  FLAT
  PERCENTAGE
}

model ChargeDiscountPackage {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id") // CUID to match Partner.id
  name      String   @db.VarChar(200)
  badge     String   @db.VarChar(20) // BASIC, BRONZE, SILVER, GOLD, PLATINUM, DIAMOND
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partner Partner                     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items   ChargeDiscountPackageItem[]

  @@unique([partnerId, badge])
  @@index([partnerId, isActive])
  @@index([badge, isActive])
  @@map("charge_discount_packages")
}

model ChargeDiscountPackageItem {
  id            String       @id @default(uuid()) @db.Uuid
  packageId     String       @map("package_id") @db.Uuid
  chargeRuleId  String       @map("charge_rule_id") @db.Uuid
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  package    ChargeDiscountPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  chargeRule ChargeRule            @relation(fields: [chargeRuleId], references: [id], onDelete: Cascade)

  @@unique([packageId, chargeRuleId])
  @@index([packageId])
  @@index([chargeRuleId])
  @@map("charge_discount_package_items")
}
