// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Partner {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique // e.g., "DELHIVERY", "BLUEDART"
  displayName String // e.g., "Delhivery", "Blue Dart"
  isActive    Boolean @default(true)

  // API Configuration
  apiUrl     String
  apiToken   String?
  apiVersion String?

  // Service Configuration
  supportsCOD     Boolean @default(false)
  supportsReverse Boolean @default(false)
  minWeight       Float? // in kg (minimum weight accepted)
  maxWeight       Float? // in kg (maximum weight accepted)
  maxDimensions   Json? // {length, width, height} in cm

  // Pricing Configuration
  baseRate         Float?
  perKgRate        Float?
  codChargePercent Float?
  fuelSurcharge    Float?

  // Delivery Configuration
  defaultDeliveryDays Int? @map("default_delivery_days") // Default delivery days for this partner

  // Service Areas
  servicePincodes String[] // Array of supported pincodes

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments           PartnerShipment[]
  rates               PartnerRate[]
  serviceabilityCache ServiceabilityCache[]
  chargePackages      ChargePackage[]

  @@map("partners")
}

model PartnerRate {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Zone Configuration
  fromPincode String
  toPincode   String
  zone        String? // A, B, C, D, E zones

  // Weight Slabs
  minWeight Float // in kg
  maxWeight Float // in kg

  // Pricing
  rate          Float
  codCharge     Float?
  fuelSurcharge Float?

  // Service Type
  serviceType String // SURFACE, AIR, EXPRESS

  // Delivery Time
  deliveryDays Int?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, fromPincode, toPincode, minWeight, maxWeight, serviceType])
  @@map("partner_rates")
}

model PartnerShipment {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  // Shipment Reference
  shipmentId   String  @unique // Reference to main shipment
  partnerAwbNo String? @unique // Partner's AWB number

  // Tracking
  status      String // BOOKED, PICKED, IN_TRANSIT, DELIVERED, RTO, etc.
  trackingUrl String?

  // Charges
  calculatedRate Float?
  actualRate     Float?
  codAmount      Float?

  // Service Details
  serviceType      String // SURFACE, AIR, EXPRESS
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  // Pickup/Delivery
  pickupDate   DateTime?
  deliveryDate DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_shipments")
}

model ServiceabilityCache {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  fromPincode String
  toPincode   String

  isServiceable Boolean
  serviceType   String? // SURFACE, AIR, EXPRESS
  deliveryDays  Int?

  // Cache metadata
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([partnerId, fromPincode, toPincode])
  @@map("serviceability_cache")
}

model AuditLog {
  id String @id @default(cuid())

  // Action Details
  action       String // RATE_CALCULATED, SHIPMENT_BOOKED, STATUS_UPDATED
  resourceType String // PARTNER, SHIPMENT, RATE
  resourceId   String?

  // User Context
  userId    String?
  ipAddress String?
  userAgent String?

  // Request/Response Data
  requestData  Json?
  responseData Json?

  // Error Information
  errorCode    String?
  errorMessage String?

  // Metadata
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

// ========================================
// GEOGRAPHICAL HIERARCHY MODELS
// ========================================

model State {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cities     City[]
  pincodes   Pincode[]
  zoneStates ZoneState[]

  @@index([code, status])
  @@map("states")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  state      State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas      Area[]
  zoneCities ZoneCity[]

  @@index([stateId, status])
  @@index([code])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  pincodes  Pincode[]
  zoneAreas ZoneArea[]

  @@index([cityId, status])
  @@index([code])
  @@map("areas")
}

model Pincode {
  id             String   @id @default(uuid()) @db.Uuid
  areaId         String?  @db.Uuid
  stateId        String   @db.Uuid
  code           String   @unique @db.VarChar(6)
  areaName       String?  @db.VarChar(255)
  district       String?  @db.VarChar(255)
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  odaApplicable  Boolean  @default(false)
  hillApplicable Boolean  @default(false)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  area            Area?                   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  state           State                   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zonePincodes    ZonePincode[]
  typeAssignments PincodeTypeAssignment[]

  @@index([code, status])
  @@index([areaId, status])
  @@index([stateId, status])
  @@index([latitude, longitude])
  @@map("pincodes")
}

// ========================================
// ZONE MANAGEMENT MODELS
// ========================================

// Zone type enum for distinguishing distance-based vs geological zones
enum ZoneType {
  DISTANCE
  GEOLOGICAL
}

// ========================================
// CHARGE PACKAGE ENUMS
// ========================================

enum ChargePackageType {
  WEIGHT
  DISTANCE
  GENERIC
}

enum ChargePackageCalcType {
  FLAT
  PERCENTAGE_OF_COD
  PERCENTAGE_OF_DECLARED_VALUE
}

enum ChargePackageAppliesTo {
  ANY
  COD
  PREPAID
}

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  partnerId   String // Reference to Partner model (keeping CUID for compatibility)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  zoneType    ZoneType @default(GEOLOGICAL) @map("zone_type")
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  zoneStates   ZoneState[]
  zoneCities   ZoneCity[]
  zoneAreas    ZoneArea[]
  zonePincodes ZonePincode[]
  milestones   ZoneMilestone[]

  @@unique([partnerId, name])
  @@index([partnerId, status])
  @@index([zoneType])
  @@map("zones")
}

model ZoneState {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  stateId   String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([zoneId, stateId])
  @@index([zoneId])
  @@index([stateId])
  @@map("zone_states")
}

model ZoneCity {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  cityId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([zoneId, cityId])
  @@index([zoneId])
  @@index([cityId])
  @@map("zone_cities")
}

model ZoneArea {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  areaId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([zoneId, areaId])
  @@index([zoneId])
  @@index([areaId])
  @@map("zone_areas")
}

model ZonePincode {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  pincodeId String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pincode Pincode @relation(fields: [pincodeId], references: [id], onDelete: Cascade)

  @@unique([zoneId, pincodeId])
  @@index([zoneId])
  @@index([pincodeId])
  @@map("zone_pincodes")
}

// ========================================
// ZONE MILESTONE CONFIGURATION (Distance Zones)
// ========================================

model ZoneMilestone {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  minKm     Int      @map("min_km")
  maxKm     Int      @map("max_km")
  suffix    String   @db.VarChar(5) // A, B, C, etc.
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, sortOrder])
  @@unique([zoneId, minKm])
  @@unique([zoneId, maxKm])
  @@index([zoneId])
  @@map("zone_milestones")
}

// ========================================
// PINCODE TYPE MANAGEMENT (Global/Admin-managed)
// ========================================

model PincodeType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  charge      Decimal  @db.Decimal(10, 2)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  assignments PincodeTypeAssignment[]

  @@index([name])
  @@index([isActive])
  @@map("pincode_types")
}

model PincodeTypeAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  pincodeId  String   @map("pincode_id") @db.Uuid
  typeId     String   @map("type_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  // Relations
  pincode     Pincode     @relation(fields: [pincodeId], references: [id], onDelete: Cascade)
  pincodeType PincodeType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([pincodeId, typeId])
  @@index([pincodeId])
  @@index([typeId])
  @@map("pincode_type_assignments")
}

// ========================================
// CHARGE PACKAGE MANAGEMENT
// ========================================

model ChargePackage {
  id        String            @id @default(uuid()) @db.Uuid
  partnerId String            @map("partner_id")
  name      String            @db.VarChar(100)
  type      ChargePackageType

  // Base charge configuration
  baseCharge Decimal @map("base_charge") @db.Decimal(10, 2)

  // Unit-based configuration (for WEIGHT and DISTANCE types)
  baseUnit    Decimal? @map("base_unit") @db.Decimal(10, 2) // Base kg or km included in baseCharge
  addonUnit   Decimal? @map("addon_unit") @db.Decimal(10, 2) // Each additional kg or km unit
  addonCharge Decimal? @map("addon_charge") @db.Decimal(10, 2) // Charge per addon unit

  // GENERIC type configuration
  appliesTo ChargePackageAppliesTo @default(ANY) @map("applies_to")
  calcType  ChargePackageCalcType  @default(FLAT) @map("calc_type")

  // Metadata for future extensibility
  metadata Json? @db.JsonB

  // Status and timestamps
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, name])
  @@index([partnerId, isActive])
  @@index([type])
  @@map("charge_packages")
}
