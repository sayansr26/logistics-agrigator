// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// PARTNER CHANNEL MANAGEMENT
// ========================================

enum ChannelMode {
  SINGLE
  MULTI
}

model Partner {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique // e.g., "DELHIVERY", "BLUEDART"
  displayName String // e.g., "Delhivery", "Blue Dart"
  isActive    Boolean @default(true)

  // Channel Mode (Single/Multi API endpoints)
  channelMode ChannelMode @default(SINGLE) @map("channel_mode")

  // API Configuration (kept for backward compatibility)
  apiUrl     String  @default("")
  apiToken   String?
  apiVersion String?

  // Service Configuration
  supportsCOD     Boolean @default(false)
  supportsReverse Boolean @default(false)
  minWeight       Float? // in kg (minimum weight accepted)
  maxWeight       Float? // in kg (maximum weight accepted)
  maxDimensions   Json? // {length, width, height} in cm

  // Delivery Configuration
  defaultDeliveryDays Int? @map("default_delivery_days") // Default delivery days for this partner

  // Service Areas
  servicePincodes String[] // Array of supported pincodes

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments           PartnerShipment[]
  serviceabilityCache ServiceabilityCache[]
  channelConfigs      PartnerChannelConfig[]
  serviceChannels     PartnerServiceChannel[]
  pincodeAssigns      PartnerPincodeAssign[]
  chargeConfigs       PartnerChargeConfig[]

  @@index([isActive])
  @@map("partners")
}

model PartnerChannelConfig {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") // CUID to match Partner.id type
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Channel Configuration
  channelName String @map("channel_name") @db.VarChar(100) // e.g., "production", "staging"
  apiUrl      String @default("") @map("api_url") @db.VarChar(500)
  apiKey      String @default("") @map("api_key") @db.VarChar(500)

  // Channel Settings
  isActive  Boolean @default(true) @map("is_active")
  isPrimary Boolean @default(false) @map("is_primary")
  priority  Int     @default(1)

  // Courier Aggregator Configuration
  aggregatorType   String  @default("NONE") @map("aggregator_type") @db.VarChar(50)
  aggregatorConfig Json?   @map("aggregator_config") // Courier-specific settings (clientName, licenseKey, warehouseCode, etc.)
  webhookSecret    String? @map("webhook_secret") @db.VarChar(500) // For courier webhook signature verification

  // Volumetric formula per partner/channel: ((boxes * L*W*H) / divisor) * factor
  // NULL on either field = use the system default (27000 / 6), resolved at read
  // time by shared/utils/weightCalc.resolveVolumetricConfig()
  volumetricDivisor Float? @map("volumetric_divisor")
  volumetricFactor  Float? @map("volumetric_factor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Carrier service channels (weight-slab shipping products) that reuse this credential channel
  serviceChannels PartnerServiceChannel[]

  @@unique([partnerId, channelName])
  @@index([partnerId, isActive])
  @@index([partnerId, isPrimary])
  @@index([partnerId, aggregatorType])
  @@map("partner_channel_configs")
}

// ========================================
// CARRIER SERVICE CHANNELS (weight-slab shipping products / accounts)
// e.g. "Delhivery Surface A" (0-5kg → Account 1), "Delhivery Air" (all weight → Account 3)
// Distinct from PartnerChannelConfig (env/credential channel): this is a shipping
// PRODUCT keyed by weight slab + account type, selected at rating/booking time.
// ========================================

enum CarrierServiceType {
  SURFACE
  AIR
  EXPRESS
}

// Business vertical a channel serves. Delhivery B2C (Express) and B2B (LTL)
// are separate accounts/APIs, so channels must be routable by shipment type.
enum ChannelBusinessType {
  B2B
  B2C
  BOTH
}

model PartnerServiceChannel {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") // CUID to match Partner.id
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Optional link to a credential channel to reuse its API key / warehouse config
  channelConfigId String?               @map("channel_config_id") @db.Uuid
  channelConfig   PartnerChannelConfig? @relation(fields: [channelConfigId], references: [id], onDelete: SetNull)

  channelName String             @map("channel_name") @db.VarChar(150) // e.g. "Delhivery Surface A"
  accountRef  String             @map("account_ref") @db.VarChar(100) // e.g. "Account 1"
  serviceType CarrierServiceType @default(SURFACE) @map("service_type")

  // Business vertical rule. BOTH matches any shipment type.
  businessType ChannelBusinessType @default(BOTH) @map("business_type")

  // Weight slab (kg). maxWeight null = open-ended ("All Weight")
  minWeight Decimal  @default(0) @map("min_weight") @db.Decimal(8, 3)
  maxWeight Decimal? @map("max_weight") @db.Decimal(8, 3)

  // Order/invoice value rule (INR). null bounds = open-ended
  minOrderAmount Decimal? @map("min_order_amount") @db.Decimal(12, 2)
  maxOrderAmount Decimal? @map("max_order_amount") @db.Decimal(12, 2)

  // Payment mode rule. Empty = all modes. Values: COD, PREPAID
  paymentModes String[] @default([]) @map("payment_modes")

  // Per-account credential override (apiKey, warehouseCode, etc.)
  credentials Json?

  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shipments     PartnerShipment[]
  chargeConfigs PartnerChargeConfig[]

  @@unique([partnerId, channelName])
  @@index([partnerId, isActive])
  @@index([partnerId, serviceType, isActive])
  @@index([partnerId, businessType, isActive])
  @@map("partner_service_channels")
}

model PartnerShipment {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  // Shipment Reference
  shipmentId   String  @unique // Reference to main shipment
  partnerAwbNo String? @unique // Partner's AWB number

  // Service channel (rule-based account) used for booking. Null = legacy/default channel
  serviceChannelId String?                @map("service_channel_id") @db.Uuid
  serviceChannel   PartnerServiceChannel? @relation(fields: [serviceChannelId], references: [id], onDelete: SetNull)

  // Tracking
  status      String // BOOKED, PICKED, IN_TRANSIT, DELIVERED, RTO, etc.
  trackingUrl String?

  // Provider sync metadata
  providerStatus      String?   @map("provider_status") @db.VarChar(50)
  providerLastSyncAt  DateTime? @map("provider_last_sync_at")
  providerRawResponse Json?     @map("provider_raw_response")

  // Label / document metadata
  courierLabelUrl   String?   @map("courier_label_url") @db.VarChar(500)
  pickupRequestId   String?   @map("pickup_request_id") @db.VarChar(100)
  pickupRequestedAt DateTime? @map("pickup_requested_at")

  // Charges
  calculatedRate Float?
  actualRate     Float?
  codAmount      Float?

  // Service Details
  serviceType      String // SURFACE, AIR, EXPRESS
  expectedDelivery DateTime?
  actualDelivery   DateTime?

  // Pickup/Delivery
  pickupDate   DateTime?
  deliveryDate DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_shipments")
}

model ServiceabilityCache {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  fromPincode String
  toPincode   String

  isServiceable Boolean
  serviceType   String? // SURFACE, AIR, EXPRESS
  deliveryDays  Int?

  // Cache metadata
  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([partnerId, fromPincode, toPincode])
  @@map("serviceability_cache")
}

model AuditLog {
  id String @id @default(cuid())

  // Action Details
  action       String // RATE_CALCULATED, SHIPMENT_BOOKED, STATUS_UPDATED
  resourceType String // PARTNER, SHIPMENT, RATE
  resourceId   String?

  // User Context
  userId    String?
  ipAddress String?
  userAgent String?

  // Request/Response Data
  requestData  Json?
  responseData Json?

  // Error Information
  errorCode    String?
  errorMessage String?

  // Metadata
  timestamp DateTime @default(now())

  @@map("audit_logs")
}

// ========================================
// GEOGRAPHICAL HIERARCHY MODELS
// ========================================

model State {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cities     City[]
  pincodes   Pincode[]
  zoneStates ZoneState[]

  @@index([code, status])
  @@map("states")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  // Government (MoF 7th Pay Commission) HRA city classification: X / Y / Z.
  // X = metro urban agglomeration, Y = tier-2, Z = other. Populated by
  // scripts/classify-cities.js from data/city-classification.json.
  cityClass String   @default("Z") @db.VarChar(1)
  isMetro   Boolean  @default(false)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  state      State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas      Area[]
  zoneCities ZoneCity[]

  @@index([stateId, status])
  @@index([code])
  @@index([isMetro])
  @@map("cities")
}

model Area {
  id        String   @id @default(uuid()) @db.Uuid
  cityId    String   @db.Uuid
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(10)
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  pincodes  Pincode[]
  zoneAreas ZoneArea[]

  @@index([cityId, status])
  @@index([code])
  @@map("areas")
}

model Pincode {
  id             String   @id @default(uuid()) @db.Uuid
  areaId         String?  @db.Uuid
  stateId        String   @db.Uuid
  code           String   @unique @db.VarChar(6)
  areaName       String?  @db.VarChar(255)
  district       String?  @db.VarChar(255)
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  odaApplicable  Boolean  @default(false)
  hillApplicable Boolean  @default(false)
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  area           Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  state          State                  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zonePincodes   ZonePincode[]
  partnerAssigns PartnerPincodeAssign[]

  @@index([code, status])
  @@index([areaId, status])
  @@index([stateId, status])
  @@index([latitude, longitude])
  @@map("pincodes")
}

// ========================================
// ZONE MANAGEMENT MODELS
// ========================================

// Zone type enum for distinguishing distance-based vs geological zones
enum ZoneType {
  DISTANCE
  GEOLOGICAL
}

model Zone {
  id          String   @id @default(uuid()) @db.Uuid
  partnerId   String // Reference to Partner model (keeping CUID for compatibility)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  zoneType    ZoneType @default(GEOLOGICAL) @map("zone_type")
  status      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  zoneStates   ZoneState[]
  zoneCities   ZoneCity[]
  zoneAreas    ZoneArea[]
  zonePincodes ZonePincode[]
  milestones   ZoneMilestone[]

  @@unique([partnerId, name])
  @@index([partnerId, status])
  @@index([zoneType])
  @@map("zones")
}

model ZoneState {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  stateId   String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([zoneId, stateId])
  @@index([zoneId])
  @@index([stateId])
  @@map("zone_states")
}

model ZoneCity {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  cityId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([zoneId, cityId])
  @@index([zoneId])
  @@index([cityId])
  @@map("zone_cities")
}

model ZoneArea {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  areaId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([zoneId, areaId])
  @@index([zoneId])
  @@index([areaId])
  @@map("zone_areas")
}

model ZonePincode {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @db.Uuid
  pincodeId String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pincode Pincode @relation(fields: [pincodeId], references: [id], onDelete: Cascade)

  @@unique([zoneId, pincodeId])
  @@index([zoneId])
  @@index([pincodeId])
  @@map("zone_pincodes")
}

// ========================================
// ZONE MILESTONE CONFIGURATION (Distance Zones)
// ========================================

model ZoneMilestone {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  minKm     Int      @map("min_km")
  maxKm     Int      @map("max_km")
  suffix    String   @db.VarChar(5) // A, B, C, etc.
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, sortOrder])
  @@unique([zoneId, minKm])
  @@unique([zoneId, maxKm])
  @@index([zoneId])
  @@map("zone_milestones")
}

// ========================================
// PINCODE TYPE MANAGEMENT
// Simplified: Only type definitions, no assignments or service charges
// ========================================

model PincodeType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  type      String   @db.VarChar(20) // "yes_no" or "number"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partnerValues PartnerPincodeTypeValue[]

  @@index([isActive, type])
  @@map("pincode_types")
}

// ========================================
// PARTNER PINCODE ASSIGNMENT
// ========================================

model PartnerPincodeAssign {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @map("partner_id") // CUID to match Partner.id
  pincodeId String   @map("pincode_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  partner           Partner                   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  pincode           Pincode                   @relation(fields: [pincodeId], references: [id], onDelete: Cascade)
  pincodeTypeValues PartnerPincodeTypeValue[]

  @@unique([partnerId, pincodeId])
  @@index([partnerId, isActive])
  @@index([pincodeId])
  @@map("partner_pincode_assigns")
}

model PartnerPincodeTypeValue {
  id               String   @id @default(uuid()) @db.Uuid
  partnerPincodeId String   @map("partner_pincode_id") @db.Uuid
  pincodeTypeId    String   @map("pincode_type_id") @db.Uuid
  value            String   @db.VarChar(255) // "yes"/"no" for yes_no, number for number
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  partnerPincode PartnerPincodeAssign @relation(fields: [partnerPincodeId], references: [id], onDelete: Cascade)
  pincodeType    PincodeType          @relation(fields: [pincodeTypeId], references: [id], onDelete: Cascade)

  @@unique([partnerPincodeId, pincodeTypeId])
  @@index([partnerPincodeId])
  @@index([pincodeTypeId])
  @@map("partner_pincode_type_values")
}

// ========================================
// CHARGES ENGINE v3 (AI-powered dynamic config)
// ChargeDefinition = catalog entry describing HOW a charge type works
// PartnerChargeConfig = per-partner (optionally per-channel) values
// ChargeConfigVersion = immutable history of every config change
// AiChargeSuggestion = AI-drafted configs pending admin review
// ========================================

enum ChargeApplyStage {
  QUOTE // always evaluated at quote time (base, COD, fuel, GST, ODA...)
  BOOKING_OPTION // evaluated only when a booking-form answer activates it (VAS)
  EVENT // post-booking financial adjustment (demurrage, reattempt...)
}

model ChargeDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(60) // e.g. "COD_CHARGE", "LOADING_UNLOADING"
  name        String  @db.VarChar(150) // human label -> breakdown chargeTypeName
  description String?
  category    String  @db.VarChar(40) // BASE|COD|VAS|PICKUP_DELIVERY|SURCHARGE|RISK|TAX|NOTIFICATION|EVENT|DISCOUNT

  applyStage ChargeApplyStage @map("apply_stage")
  phase      Int              @default(500) // pipeline ordering: 100 base .. 900 GST

  // { method: FLAT|PERCENT_WITH_MIN|PER_UNIT|SLAB|MATRIX|PER_UNIT_TIME|RATE_ADJUSTMENT|DISCOUNT,
  //   basis: COD_AMOUNT|INVOICE_VALUE|CHARGEABLE_WEIGHT|ANSWER_VALUE|SUBTOTAL|NONE,
  //   paramsSchema: {...} } — the contract PartnerChargeConfig.config must satisfy
  computation Json

  // Dynamic booking-form spec (BOOKING_OPTION only):
  // { key, label, type: boolean|select|datetime|number, options?, followUp? }
  bookingQuestion Json? @map("booking_question")

  // Default gating: { all|any: [ { fact, op, value } ] }
  conditions Json?

  // { group, strategy: HIGHEST|SUM, perSide?: bool } — G2-compatible aggregation
  aggregation Json?

  // { fuelApplicable?, taxable?, addToCodCollectable?, aiAssisted? }
  flags Json?

  isSystem Boolean @default(false) @map("is_system") // seeded core (GST, FUEL) — non-deletable
  isActive Boolean @default(true) @map("is_active")
  version  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partnerConfigs PartnerChargeConfig[]

  @@index([applyStage, isActive])
  @@index([category, isActive])
  @@map("charge_definitions")
}

model PartnerChargeConfig {
  id                 String  @id @default(uuid()) @db.Uuid
  partnerId          String  @map("partner_id") // CUID to match Partner.id
  channelId          String? @map("channel_id") @db.Uuid // optional PartnerServiceChannel override
  chargeDefinitionId String  @map("charge_definition_id") @db.Uuid

  // Values satisfying the definition's computation.paramsSchema. May reference
  // Zone/ZoneMilestone/PincodeType ids as UUID strings — referential validity is
  // enforced by partnerChargeConfigService on every write.
  config Json

  // Partner-level condition overrides, merged over the definition defaults
  conditions Json?

  priority      Int       @default(100)
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  version       Int       @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  partner          Partner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  channel          PartnerServiceChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  chargeDefinition ChargeDefinition       @relation(fields: [chargeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([partnerId, chargeDefinitionId, channelId])
  @@index([partnerId, isActive])
  @@index([chargeDefinitionId, isActive])
  @@map("partner_charge_configs")
}

model ChargeConfigVersion {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(30) // DEFINITION | PARTNER_CONFIG
  entityId     String   @map("entity_id") @db.Uuid
  version      Int
  snapshot     Json // full row snapshot AFTER the change
  changeSource String   @default("MANUAL") @map("change_source") @db.VarChar(20) // MANUAL | AI_SUGGESTED | LEGACY_IMPORT
  changedById  String?  @map("changed_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@map("charge_config_versions")
}

model AiChargeSuggestion {
  id           String    @id @default(uuid()) @db.Uuid
  kind         String    @db.VarChar(30) // CONFIG_FROM_NL | LEGACY_IMPORT | ANOMALY | CONFIG_TUNE
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED | APPLIED
  inputContext Json      @map("input_context") // NL prompt / legacy rules chunk / anomaly window
  suggestion   Json // proposed ChargeDefinition + PartnerChargeConfig drafts
  // Validation errors found in the AI output, surfaced to the reviewing admin
  validation   Json?
  modelUsed    String?   @map("model_used") @db.VarChar(60)
  createdById  String?   @map("created_by_id") @db.Uuid
  reviewedById String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([kind, status])
  @@map("ai_charge_suggestions")
}
