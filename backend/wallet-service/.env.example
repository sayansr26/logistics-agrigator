# Wallet Service Environment Configuration

# Node Environment
NODE_ENV=development
SERVICE_NAME=wallet-service
PORT=3006

# Database Configuration (separate database for wallet service)
DATABASE_URL=postgresql://logistics:logistics123@postgres:5432/logistics_wallet

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration (from shared auth service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=2592000

# External Wallet API Configuration
EXTERNAL_WALLET_API_URL=https://wapi.websiteduniya.com/api/v1
EXTERNAL_WALLET_SECRET_KEY=production-hmac-secret-key-256-bit-minimum-ultra-secure-change-me
EXTERNAL_WALLET_USER_ID=wallet-service
EXTERNAL_WALLET_JWT_TOKEN=

# Default Client Configuration
DEFAULT_CLIENT_CODE=DEFAULT

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_STRICT_MAX=50
RATE_LIMIT_BALANCE_MAX=100
RATE_LIMIT_TRANSACTION_MAX=30

# Cache TTL Configuration (in seconds)
CACHE_WALLET_TTL=600
CACHE_BALANCE_TTL=300
CACHE_TRANSACTIONS_TTL=60

# Circuit Breaker Configuration
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# Security Configuration
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_LEVEL=debug

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000

# Payment Gateway Configuration (Future)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt

# Webhook Configuration (Future)
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT=30000

# Multi-tenant Configuration
ENABLE_MULTI_TENANT=true
DEFAULT_CLIENT_CODE=DEFAULT

# External Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://auth-service:3002
USER_SERVICE_URL=http://user-service:3003
PARTNER_SERVICE_URL=http://partner-service:3005
SHIPMENT_SERVICE_URL=http://shipment-service:3004

# Development Configuration
ENABLE_SWAGGER=true
SWAGGER_HOST=localhost
SWAGGER_SCHEMES=http
