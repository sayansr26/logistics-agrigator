// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED

  @@map("wallet_status")
}

enum TransactionType {
  DEBIT
  CREDIT
  REFUND
  LOAD_BALANCE
  ADJUSTMENT
  TOP_UP

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  PROCESSING

  @@map("transaction_status")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED

  @@map("payment_status")
}

model Wallet {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  balance          Decimal      @default(0) @db.Decimal(15, 2)
  externalWalletId String?      @db.VarChar(255) // External wallet service ID
  clientCode       String       @default("DEFAULT") @db.VarChar(50)
  status           WalletStatus @default(ACTIVE)
  metadata         Json? // Additional wallet metadata
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  // Relations
  transactions    Transaction[]
  paymentGateways PaymentGateway[]
  auditLogs       AuditLog[]

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([clientCode])
  @@index([createdAt])
  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  walletId    String            @db.Uuid
  type        TransactionType
  amount      Decimal           @db.Decimal(15, 2)
  description String?           @db.Text
  reference   String?           @db.VarChar(255) // Shipment ID, Order ID, etc
  status      TransactionStatus @default(PENDING)
  metadata    Json? // Additional transaction metadata
  createdAt   DateTime          @default(now()) @db.Timestamptz
  updatedAt   DateTime          @updatedAt @db.Timestamptz

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@map("transactions")
}

/// @deprecated — superseded by PaymentOrder. Do not write to this table.
model PaymentGateway {
  id          String        @id @default(uuid()) @db.Uuid
  walletId    String        @db.Uuid
  provider    String        @db.VarChar(50) // "razorpay", "payu", "stripe", etc
  paymentId   String        @db.VarChar(255) // Gateway payment ID
  orderId     String?       @db.VarChar(255) // Gateway order ID
  amount      Decimal       @db.Decimal(15, 2)
  currency    String        @default("INR") @db.VarChar(3)
  status      PaymentStatus @default(PENDING)
  gatewayData Json? // Gateway-specific data
  webhookData Json? // Webhook response data
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([walletId])
  @@index([provider])
  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_gateways")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  walletId   String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100) // CREATE_WALLET, DEBIT, CREDIT, etc
  resource   String   @db.VarChar(50) // "Wallet", "Transaction", etc
  resourceId String?  @db.Uuid
  details    Json? // Additional audit details
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz

  // Relations
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([walletId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// COD REMITTANCE / SETTLEMENT MODULE
// ============================================================

enum CodCollectionStatus {
  PENDING // delivered, COD not yet collected/reported by courier
  COLLECTED // courier reported/collected the COD
  REMITTED // settled/paid out to the customer

  @@map("cod_collection_status")
}

enum CodSource {
  API // auto-fetched from courier API
  IMPORT // imported from courier Excel/CSV report
  MANUAL // manual entry

  @@map("cod_source")
}

enum ReconStatus {
  UNRECONCILED
  MATCHED
  MISSING // expected COD not present in courier report
  SHORT // courier reported less than expected
  EXCESS // courier reported more than expected
  DUPLICATE // duplicate collection for the same AWB
  MANUAL // manually reconciled

  @@map("recon_status")
}

enum SettlementStatus {
  DRAFT
  FINANCE_VERIFICATION
  APPROVED
  RELEASED
  REJECTED
  HOLD
  CANCELLED

  @@map("settlement_status")
}

enum SettlementPaymentMode {
  WALLET_CREDIT
  BANK_TRANSFER
  UPI
  MANUAL

  @@map("settlement_payment_mode")
}

enum SettlementCycle {
  DAILY
  WEEKLY
  T_PLUS_1
  T_PLUS_2

  @@map("settlement_cycle")
}

enum AdjustmentType {
  LOST
  DAMAGE
  SHORT_COD
  EXCESS_COD
  CREDIT_NOTE
  DEBIT_NOTE
  MANUAL

  @@map("adjustment_type")
}

/// Mirror of a delivered COD shipment used for remittance/settlement.
model CodShipment {
  id          String  @id @default(uuid()) @db.Uuid
  shipmentId  String  @unique @db.Uuid // source shipment-service id
  awbNumber   String  @db.VarChar(50)
  orderId     String  @db.VarChar(100)
  invoiceNo   String? @db.VarChar(100)
  userId      String  @db.Uuid // customer who owns the shipment
  clientCode  String  @default("DEFAULT") @db.VarChar(50)
  partnerId   String? @db.VarChar(50)
  partnerName String? @db.VarChar(100)

  codAmount        Decimal             @db.Decimal(15, 2) // expected COD
  collectedAmount  Decimal?            @db.Decimal(15, 2) // reported/collected
  collectionStatus CodCollectionStatus @default(PENDING)
  reconStatus      ReconStatus         @default(UNRECONCILED)

  deliveredAt  DateTime? @db.Timestamptz
  settlementId String?   @db.Uuid // set when included in a settlement

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  reconciliations CodReconciliation[]
  settlement      Settlement?         @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([awbNumber])
  @@index([userId])
  @@index([clientCode])
  @@index([collectionStatus])
  @@index([reconStatus])
  @@index([settlementId])
  @@map("cod_shipments")
}

/// A courier-reported COD collection (from API / import / manual).
model CodCollection {
  id                   String    @id @default(uuid()) @db.Uuid
  awbNumber            String    @db.VarChar(50)
  reportedAmount       Decimal   @db.Decimal(15, 2)
  collectionDate       DateTime? @db.Timestamptz
  source               CodSource @default(MANUAL)
  courierReportId      String?   @db.VarChar(100)
  matchedCodShipmentId String?   @db.Uuid
  verified             Boolean   @default(false)
  verifiedBy           String?   @db.Uuid
  verifiedAt           DateTime? @db.Timestamptz
  metadata             Json?
  createdAt            DateTime  @default(now()) @db.Timestamptz

  @@index([awbNumber])
  @@index([source])
  @@index([matchedCodShipmentId])
  @@index([verified])
  @@map("cod_collections")
}

/// Reconciliation record comparing expected COD vs courier-reported amount.
model CodReconciliation {
  id             String      @id @default(uuid()) @db.Uuid
  codShipmentId  String      @db.Uuid
  collectionId   String?     @db.Uuid
  expectedAmount Decimal     @db.Decimal(15, 2)
  reportedAmount Decimal?    @db.Decimal(15, 2)
  variance       Decimal     @default(0) @db.Decimal(15, 2)
  status         ReconStatus @default(UNRECONCILED)
  resolvedBy     String?     @db.Uuid
  remarks        String?     @db.Text
  createdAt      DateTime    @default(now()) @db.Timestamptz
  updatedAt      DateTime    @updatedAt @db.Timestamptz

  codShipment CodShipment @relation(fields: [codShipmentId], references: [id], onDelete: Cascade)

  @@index([codShipmentId])
  @@index([status])
  @@map("cod_reconciliations")
}

/// A COD settlement to a customer, moving through the approval workflow.
model Settlement {
  id           String @id @default(uuid()) @db.Uuid
  settlementNo String @unique @db.VarChar(50)
  userId       String @db.Uuid
  clientCode   String @default("DEFAULT") @db.VarChar(50)

  totalCod         Decimal @default(0) @db.Decimal(15, 2)
  totalAdjustments Decimal @default(0) @db.Decimal(15, 2) // signed sum of adjustments
  netPayable       Decimal @default(0) @db.Decimal(15, 2) // totalCod + totalAdjustments

  status      SettlementStatus       @default(DRAFT)
  paymentMode SettlementPaymentMode?
  cycle       SettlementCycle?

  approvedBy     String?   @db.Uuid
  approvedAt     DateTime? @db.Timestamptz
  releasedBy     String?   @db.Uuid
  releasedAt     DateTime? @db.Timestamptz
  rejectedReason String?   @db.Text
  holdReason     String?   @db.Text
  remarks        String?   @db.Text

  payoutTransactionId String? @db.VarChar(100)
  payoutReference     String? @db.VarChar(200)

  createdBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  items        SettlementItem[]
  adjustments  SettlementAdjustment[]
  codShipments CodShipment[]

  @@index([userId])
  @@index([clientCode])
  @@index([status])
  @@index([createdAt])
  @@map("settlements")
}

/// Line item linking a COD shipment to a settlement.
model SettlementItem {
  id            String   @id @default(uuid()) @db.Uuid
  settlementId  String   @db.Uuid
  codShipmentId String   @db.Uuid
  awbNumber     String   @db.VarChar(50)
  amount        Decimal  @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, codShipmentId])
  @@index([settlementId])
  @@index([codShipmentId])
  @@map("settlement_items")
}

/// Adjustment applied to a settlement (lost/damage/short/excess/credit/debit/manual).
/// `amount` is signed: positive increases net payable to the customer, negative decreases.
model SettlementAdjustment {
  id           String         @id @default(uuid()) @db.Uuid
  settlementId String?        @db.Uuid
  userId       String?        @db.Uuid
  clientCode   String?        @db.VarChar(50)
  type         AdjustmentType
  amount       Decimal        @db.Decimal(15, 2)
  reason       String         @db.Text
  referenceAwb String?        @db.VarChar(50)
  createdBy    String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz

  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([type])
  @@index([userId])
  @@map("settlement_adjustments")
}

/// Configurable settlement cycle/rules per customer or courier.
model SettlementRule {
  id          String                @id @default(uuid()) @db.Uuid
  scope       String                @default("CUSTOMER") @db.VarChar(20) // CUSTOMER | COURIER | GLOBAL
  clientCode  String?               @db.VarChar(50)
  userId      String?               @db.Uuid
  partnerId   String?               @db.VarChar(50)
  cycle       SettlementCycle       @default(T_PLUS_2)
  paymentMode SettlementPaymentMode @default(WALLET_CREDIT)
  autoRelease Boolean               @default(false)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now()) @db.Timestamptz
  updatedAt   DateTime              @updatedAt @db.Timestamptz

  @@index([scope, isActive])
  @@index([userId])
  @@index([partnerId])
  @@index([clientCode])
  @@map("settlement_rules")
}

// ============================================================
// PAYMENT GATEWAY / WALLET TOP-UP MODULE (Razorpay)
// ------------------------------------------------------------
// Column names follow this file's dominant style: no per-column
// @map(), so Prisma's default camelCase column names are used.
// The hand-written migration DDL quotes them accordingly.
// ============================================================

enum PaymentProviderMode {
  TEST
  LIVE

  @@map("payment_provider_mode")
}

enum PaymentOrderKind {
  SELF_SERVE // customer/outlet initiated checkout
  ADMIN_LINK // payment link generated by an admin on a user's behalf
  QR_STATIC // inbound payment on a static UPI QR pinned to an outlet

  @@map("payment_order_kind")
}

enum PaymentOrderStatus {
  CREATED
  PENDING
  PAID
  CREDITED
  RECONCILE_PENDING
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED

  @@map("payment_order_status")
}

enum ManualTopupStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CREDITED
  FAILED

  @@map("manual_topup_status")
}

/// Payment provider (Razorpay, ...) credentials + limits.
/// Secrets are stored as AES-256-GCM ciphertext; only the *KeyId columns are
/// plaintext because they are the public checkout key handed to the browser.
///
/// NOTE ON UNIQUENESS: `clientId` is always NULL today (platform-level config);
/// the column exists so per-client provider accounts can be added later.
/// Postgres treats NULLs as DISTINCT, so `@@unique([provider, clientId])` does
/// NOT prevent two platform-level rows for the same provider. Real
/// platform-level uniqueness is enforced by the partial unique index
/// `payment_provider_configs_provider_platform_uniq`
/// (ON (provider) WHERE clientId IS NULL) created in the migration.
model PaymentProviderConfig {
  id        String              @id @default(uuid()) @db.Uuid
  clientId  String?             @db.Uuid // always NULL for now; reserved for per-client accounts
  provider  String              @db.VarChar(50) // "razorpay"
  isEnabled Boolean             @default(false)
  mode      PaymentProviderMode @default(TEST)

  // Public checkout key - PLAINTEXT by design
  testKeyId String? @db.VarChar(255)
  liveKeyId String? @db.VarChar(255)

  // AES-256-GCM ciphertext - never returned to clients
  testKeySecretEnc     String? @db.Text
  testWebhookSecretEnc String? @db.Text
  liveKeySecretEnc     String? @db.Text
  liveWebhookSecretEnc String? @db.Text

  /// Descriptor-driven credential bag for providers whose fields do not fit the legacy
  /// keyId/keySecret/webhookSecret trio (CCAvenue: merchantId, accessCode, workingKey).
  /// Shape: { "<fieldName>": { "v": "<plaintext>" } | { "enc": "<AES-256-GCM envelope>" } }
  /// The v/enc discriminant makes it impossible to mistake plaintext for ciphertext.
  /// NEVER add these to SAFE_SELECT - they carry envelopes.
  testCredentials Json?
  liveCredentials Json?

  currency     String  @default("INR") @db.VarChar(3)
  minAmount    Decimal @default(100) @db.Decimal(15, 2)
  maxAmount    Decimal @default(200000) @db.Decimal(15, 2)
  quickAmounts Json? // e.g. [500, 1000, 2000, 5000]

  paymentLinkExpiryHours Int @default(24)

  lastTestedAt    DateTime? @db.Timestamptz
  lastTestStatus  String?   @db.VarChar(20) // SUCCESS | FAILED
  lastTestMessage String?   @db.Text

  metadata  Json?
  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([provider, clientId], name: "provider_client_unique")
  @@index([isEnabled])
  @@map("payment_provider_configs")
}

/// A single wallet top-up attempt through a payment provider.
model PaymentOrder {
  id       String              @id @default(uuid()) @db.Uuid
  kind     PaymentOrderKind
  provider String              @db.VarChar(50)
  /// SNAPSHOTTED at creation time: flipping the provider config between TEST
  /// and LIVE later must never strand or mis-route in-flight orders.
  mode     PaymentProviderMode
  isTest   Boolean             @default(false) // derived from `mode`; TEST orders never call the external wallet API

  /// EXTERNAL wallet identity (phone number for outlets). Deliberately NOT a
  /// FK to Wallet - Wallet.userId is @db.Uuid and this is the external system's
  /// identifier, which is a different namespace.
  walletUserId  String  @db.VarChar(255)
  clientCode    String  @default("DEFAULT") @db.VarChar(50)
  subjectUserId String? @db.Uuid // portal user UUID when known; audit only, no FK

  payerName  String? @db.VarChar(255)
  payerEmail String? @db.VarChar(255)
  payerPhone String? @db.VarChar(20)

  amount      Decimal @db.Decimal(15, 2)
  amountPaise Int
  currency    String  @default("INR") @db.VarChar(3)

  status PaymentOrderStatus @default(CREATED)

  providerOrderId   String?   @db.VarChar(255)
  providerLinkId    String?   @db.VarChar(255)
  providerPaymentId String?   @db.VarChar(255)
  shortUrl          String?   @db.Text
  expiresAt         DateTime? @db.Timestamptz

  /// Deterministic idempotency key `<PREFIX>_<providerPaymentId>` (RZP_ for
  /// razorpay, CCAV_ for ccavenue) sent to the
  /// external wallet API, which 409s on reuse - that 409 is a success signal.
  externalReferenceId   String?   @db.VarChar(255)
  externalTransactionId String?   @db.VarChar(255)
  creditedAt            DateTime? @db.Timestamptz

  reconcileAttempts Int       @default(0)
  lastReconcileAt   DateTime? @db.Timestamptz
  nextRetryAt       DateTime? @db.Timestamptz
  reconcileError    String?   @db.Text
  needsManualAction Boolean   @default(false)

  refundedAmount Decimal @default(0) @db.Decimal(15, 2)

  notes       String?  @db.Text
  gatewayData Json?
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  webhookEvents PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId], name: "provider_payment_unique")
  @@index([walletUserId, clientCode])
  @@index([subjectUserId])
  @@index([status])
  @@index([status, nextRetryAt])
  @@index([providerOrderId])
  @@index([providerLinkId])
  @@index([kind, createdAt])
  @@index([createdBy])
  @@map("payment_orders")
}

/// Raw provider webhook envelope. `@@unique([provider, providerEventId])` is
/// the replay guard: a duplicate delivery collides here and is skipped.
model PaymentWebhookEvent {
  id              String  @id @default(uuid()) @db.Uuid
  provider        String  @db.VarChar(50)
  providerEventId String  @db.VarChar(255)
  eventType       String  @db.VarChar(100)
  paymentOrderId  String? @db.Uuid

  signatureValid  Boolean @default(false)
  processed       Boolean @default(false)
  processingError String? @db.Text

  payload     Json
  headers     Json?
  receivedAt  DateTime  @default(now()) @db.Timestamptz
  processedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz

  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentOrderId])
  @@index([eventType])
  @@index([processed])
  @@index([receivedAt])
  @@map("payment_webhook_events")
}

/// Manual (off-gateway) wallet credit request, under maker-checker.
/// `reason` and `externalReference` are both mandatory safeguards.
model ManualTopupRequest {
  id            String  @id @default(uuid()) @db.Uuid
  walletUserId  String  @db.VarChar(255)
  clientCode    String  @default("DEFAULT") @db.VarChar(50)
  subjectUserId String? @db.Uuid

  amount   Decimal @db.Decimal(15, 2)
  currency String  @default("INR") @db.VarChar(3)

  reason            String @db.Text
  externalReference String @db.VarChar(255) // bank UTR / NEFT ref / cheque no

  status ManualTopupStatus @default(PENDING_APPROVAL)

  // Policy snapshot at request time, so later policy edits do not rewrite history
  thresholdAtRequest Decimal @db.Decimal(15, 2)
  capAtRequest       Decimal @db.Decimal(15, 2)

  requestedBy   String    @db.Uuid
  requestedAt   DateTime  @default(now()) @db.Timestamptz
  reviewedBy    String?   @db.Uuid
  reviewedAt    DateTime? @db.Timestamptz
  reviewRemarks String?   @db.Text

  externalReferenceId   String?   @db.VarChar(255) // `MANUAL_<id>` idempotency key
  externalTransactionId String?   @db.VarChar(255)
  creditedAt            DateTime? @db.Timestamptz
  creditError           String?   @db.Text

  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([externalReferenceId])
  @@index([status, requestedAt])
  @@index([walletUserId, clientCode])
  @@index([requestedBy])
  @@index([reviewedBy])
  @@map("manual_topup_requests")
}

/// Manual top-up policy. `clientId` is NULL for the platform-level row;
/// uniqueness of that single platform row is enforced by the partial unique
/// index `wallet_topup_policies_platform_uniq` in the migration.
model WalletTopupPolicy {
  id       String  @id @default(uuid()) @db.Uuid
  clientId String? @db.Uuid

  manualMaxPerTransaction Decimal  @default(100000) @db.Decimal(15, 2)
  manualApprovalThreshold Decimal  @default(25000) @db.Decimal(15, 2)
  manualMaxPerDayPerUser  Decimal? @db.Decimal(15, 2)

  requireReason    Boolean @default(true)
  requireReference Boolean @default(true)

  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([clientId])
  @@map("wallet_topup_policies")
}

// ============================================================
// STATIC UPI QR COLLECTION MODULE (CCAvenue UPI QR)
// ------------------------------------------------------------
// Column names follow this file's dominant style: no per-column
// @map(), so Prisma's default camelCase column names are used.
// The hand-written migration DDL quotes them accordingly.
// ============================================================

/// Which strategy produced `QrCollection.dedupeKey`. A UTR-keyed hash is a strong
/// idempotency key (the bank's own reference); a content hash is a weak one and is
/// why UTR-less collections are forced into the human queue. Recorded so an
/// operator can tell the two apart without re-deriving the hash.
enum QrDedupeStrategy {
  UTR
  CONTENT

  @@map("qr_dedupe_strategy")
}

/// Why a collection is sitting in the unattributed queue. Typed rather than
/// buried in `metadata` JSON so the ops queue is filterable without a JSON
/// predicate.
enum QrUnattributedReason {
  NO_QR_MATCH // the identifier resolved to nothing
  INACTIVE_QR // it matched a retired QR - deliberately NOT auto-credited
  NO_UTR // weak dedupe key: a human must see it before it can credit

  @@map("qr_unattributed_reason")
}

enum QrCollectionSource {
  WEBHOOK
  IMPORT
  MANUAL
  POLL

  @@map("qr_collection_source")
}

enum QrCollectionStatus {
  UNATTRIBUTED
  ASSIGN_PENDING
  ATTRIBUTED
  CREDIT_PENDING
  CREDITED
  REJECTED
  IGNORED

  @@map("qr_collection_status")
}

/// A static UPI QR pinned to one outlet - the ATTRIBUTION KEY of this module.
///
/// ⚠️ MONEY-ROUTING CHANGE: creating a row here, or repointing an existing row
/// to a different `walletUserId`, changes which wallet every future payment on
/// that QR lands in. Treat every write as a privileged, fully audited operation.
///
/// Retirement is done by flipping `isActive` to false, never by deleting: the
/// partial unique indexes are scoped `WHERE "isActive"` so a QR identifier or
/// VPA can be retired and later re-issued, while two *live* rows can never
/// claim the same identifier.
model OutletPaymentQr {
  id       String @id @default(uuid()) @db.Uuid
  provider String @default("ccavenue_upi_qr") @db.VarChar(50)

  /// EXTERNAL wallet identity (the outlet's phone), the same namespace as
  /// `PaymentOrder.walletUserId`. Deliberately NOT a FK: `Outlet` lives in
  /// user-service, a different database, so no cross-database relation exists.
  walletUserId  String  @db.VarChar(255)
  clientCode    String  @default("DEFAULT") @db.VarChar(50)
  subjectUserId String? @db.Uuid // portal user UUID when known; audit only, no FK
  outletId      String? @db.Uuid // display only - user-service owns the record
  outletName    String? @db.VarChar(200)

  qrIdentifier String? @db.VarChar(190) // provider's QR / merchant reference
  vpa          String? @db.VarChar(190)
  qrPayload    String? @db.Text // raw UPI intent string
  qrImageUrl   String? @db.Text

  mode     PaymentProviderMode @default(TEST)
  isActive Boolean             @default(true)
  label    String?             @db.VarChar(120)

  /// ALERTING / velocity signals only - NOT credit gates. An attributed payment
  /// always auto-credits: the money is already in the merchant account, and
  /// refusing it would create a refund liability instead of preventing anything.
  maxPerCreditAmount Decimal? @db.Decimal(15, 2)
  maxPerDayAmount    Decimal? @db.Decimal(15, 2)
  maxPerDayCount     Int?

  provisionedAt DateTime? @db.Timestamptz
  provisionedBy String?   @db.Uuid
  deactivatedAt DateTime? @db.Timestamptz
  deactivatedBy String?   @db.Uuid

  providerData Json? // raw provider provisioning response
  metadata     Json?
  createdBy    String?  @db.Uuid
  updatedBy    String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  collections QrCollection[]

  @@index([walletUserId, clientCode])
  @@index([outletId])
  @@index([subjectUserId])
  @@index([isActive])
  @@map("outlet_payment_qrs")
}

/// A raw inbound static-QR collection (webhook / import / manual / poll).
///
/// WRITTEN UNCONDITIONALLY, whether or not it matches an `OutletPaymentQr` -
/// mirroring `CodCollection`. Money that arrived must be recorded even when we
/// cannot yet say whose it is; dropping unmatched rows would lose the evidence.
///
/// `outletPaymentQrId IS NULL` is what DEFINES the unattributed queue that ops
/// works through - it is a state, not an error.
model QrCollection {
  id       String             @id @default(uuid()) @db.Uuid
  provider String             @default("ccavenue_upi_qr") @db.VarChar(50)
  source   QrCollectionSource @default(WEBHOOK)
  status   QrCollectionStatus @default(UNATTRIBUTED)

  utr String? @db.VarChar(64) // nullable: the provider may not send one

  /// `sha256(provider|utr)`, or a content hash when there is no UTR.
  /// THIS IS THE CONSTRAINT THE COD MODULE IS MISSING: it makes re-importing
  /// the same CSV a no-op instead of a double count.
  dedupeKey      String           @unique @db.VarChar(80)
  dedupeStrategy QrDedupeStrategy @default(CONTENT)

  /// Populated only while `status = UNATTRIBUTED`; cleared on attribution.
  unattributedReason QrUnattributedReason?

  /// How many times this payment has been delivered to us (webhook redelivery,
  /// re-import). Incremented on every duplicate hit so "this UTR arrived 14
  /// times" is visible on the row, not only in the audit log.
  deliveryCount Int @default(1)

  providerTxnId String? @db.VarChar(190)
  qrIdentifier  String? @db.VarChar(190) // AS RECEIVED, before matching
  payerVpa      String? @db.VarChar(190)
  payerName     String? @db.VarChar(255)

  amount      Decimal @db.Decimal(15, 2)
  amountPaise Int
  currency    String  @default("INR") @db.VarChar(3)

  txnAt      DateTime? @db.Timestamptz
  receivedAt DateTime  @default(now()) @db.Timestamptz

  outletPaymentQrId String?              @db.Uuid // the nullable match FK
  walletUserId      String?              @db.VarChar(255)
  clientCode        String?              @db.VarChar(50)
  subjectUserId     String?              @db.Uuid
  mode              PaymentProviderMode?

  /// FK to `payment_orders` declared in raw DDL with ON DELETE SET NULL.
  /// Deliberately NOT a Prisma relation, to keep `PaymentOrder` free of a
  /// back-reference field.
  paymentOrderId String? @db.Uuid

  manualTopupRequestId String? @db.Uuid
  externalReferenceId  String? @db.VarChar(255) // `UPIQR_<utr>` / `UPIQRC_<id>`

  attributedBy      String?   @db.Uuid
  attributedAt      DateTime? @db.Timestamptz
  rejectedBy        String?   @db.Uuid
  rejectedAt        DateTime? @db.Timestamptz
  remarks           String?   @db.Text
  lastError         String?   @db.Text
  needsManualAction Boolean   @default(false)

  rawPayload Json?
  metadata   Json?
  createdBy  String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  outletPaymentQr OutletPaymentQr? @relation(fields: [outletPaymentQrId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([outletPaymentQrId])
  @@index([walletUserId, clientCode])
  @@index([utr])
  @@index([qrIdentifier])
  @@index([receivedAt])
  @@index([paymentOrderId])
  @@index([status, receivedAt])
  @@index([unattributedReason])
  @@map("qr_collections")
}
