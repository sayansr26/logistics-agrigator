# =============== PRODUCTION DOCKERFILE ===============
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache openssl bash
RUN npm install -g pnpm@8.15.1

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY shared ./shared
COPY backend/support-service/package.json ./backend/support-service/

RUN cd backend/support-service && pnpm install --prod --frozen-lockfile --ignore-scripts

COPY backend/support-service ./backend/support-service

# Copy shared into service directory for relative imports
RUN cp -r /app/shared /app/backend/support-service/
RUN cd backend/support-service && npx prisma@5.22.0 generate

# Create non-root user first
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Copy production entrypoint script for automated migrations
COPY --chown=nodejs:nodejs scripts/production-entrypoint.sh /app/production-entrypoint.sh
RUN chmod +x /app/production-entrypoint.sh
RUN mkdir -p /app/logs/support-service && chown -R nodejs:nodejs /app/logs
RUN chown -R nodejs:nodejs /app

USER nodejs
WORKDIR /app

EXPOSE 3007

ENV NODE_ENV=production
ENV PORT=3007
ENV SERVICE_NAME=support-service

ENTRYPOINT ["/app/production-entrypoint.sh"]
CMD ["node", "backend/support-service/server.js"]
