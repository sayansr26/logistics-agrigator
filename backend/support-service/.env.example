# Environment variables for Support Service

# Database
DATABASE_URL="postgresql://logistics:logistics123@localhost:5432/logistics_support"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="3600"

# Service Configuration
NODE_ENV="development"
PORT="8004"

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL="http://localhost:8001"
USER_SERVICE_URL="http://localhost:8002"
SHIPMENT_SERVICE_URL="http://localhost:8003"
API_GATEWAY_URL="http://localhost:8000"
PLATFORM_SERVICE_URL="http://localhost:8005"

# External Services
WALLET_SERVICE_URL="http://localhost:8006"
WALLET_SERVICE_API_KEY="your_wallet_service_api_key"
PARTNER_SERVICE_URL="http://localhost:8007"
PARTNER_SERVICE_API_KEY="your_partner_service_api_key"

# Prisma
PRISMA_QUERY_ENGINE_BINARY=""

# Support Service Specific
TICKET_ATTACHMENT_UPLOAD_PATH="uploads/tickets"
MAX_ATTACHMENT_SIZE="10485760"
ALLOWED_ATTACHMENT_TYPES="jpg,jpeg,png,pdf,doc,docx,txt"

# Support Configuration
DEFAULT_TICKET_PRIORITY="medium"
AUTO_ASSIGN_TICKETS="true"
TICKET_ESCALATION_TIME="86400"
MAX_TICKETS_PER_USER="10"

# Communication Settings
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="your_sendgrid_api_key"
SUPPORT_EMAIL="support@logistics.com"
NOTIFICATION_EMAIL="notifications@logistics.com"

# Chat/Real-time Support
ENABLE_LIVE_CHAT="true"
CHAT_SESSION_TIMEOUT="1800"
