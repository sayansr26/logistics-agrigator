# =============== PRODUCTION DOCKERFILE ===============
FROM node:18-alpine

WORKDIR /app

RUN apk add --no-cache openssl bash
RUN npm install -g pnpm@8.15.1

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY shared ./shared
COPY backend/user-service/package.json ./backend/user-service/

RUN cd backend/user-service && pnpm install --prod --frozen-lockfile --ignore-scripts

COPY backend/user-service ./backend/user-service

# Copy shared into service directory for relative imports
RUN cp -r /app/shared /app/backend/user-service/
RUN cd backend/user-service && npx prisma generate

# Create non-root user first
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Copy production entrypoint script for automated migrations
COPY --chown=nodejs:nodejs scripts/production-entrypoint.sh /app/production-entrypoint.sh
RUN chmod +x /app/production-entrypoint.sh
RUN mkdir -p /app/logs/user-service && chown -R nodejs:nodejs /app/logs
RUN chown -R nodejs:nodejs /app

USER nodejs
WORKDIR /app

EXPOSE 3003

ENV NODE_ENV=production
ENV PORT=3003
ENV SERVICE_NAME=user-service

ENTRYPOINT ["/app/production-entrypoint.sh"]
CMD ["node", "backend/user-service/server.js"]
