// User Service Prisma Schema
// Focuses on user profiles, client management, and user-related data
// Authentication is handled by auth-service (singleton pattern)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Profile - extends auth service user with detailed profile information
model UserProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid // References auth-service user.id
  firstName   String  @map("first_name") @db.VarChar(100)
  lastName    String  @map("last_name") @db.VarChar(100)
  phoneNumber String? @map("phone_number") @db.VarChar(20)
  companyName String? @map("company_name") @db.VarChar(200)
  designation String? @db.VarChar(100)
  department  String? @db.VarChar(100)

  // Address information
  address        Json? // Flexible address storage
  billingAddress Json? @map("billing_address") // Separate billing address

  // Profile settings and preferences
  preferences Json? // User preferences (theme, notifications, etc.)
  timezone    String? @db.VarChar(50)
  language    String  @default("en") @db.VarChar(10)

  // Profile status
  isActive        Boolean @default(true) @map("is_active")
  isVerified      Boolean @default(false) @map("is_verified")
  profileComplete Boolean @default(false) @map("profile_complete")

  // Client association for multi-tenancy
  clientId String? @map("client_id") @db.Uuid

  // Customer association for RBAC
  customerId   String? @map("customer_id") @db.Uuid
  customerRole String? @map("customer_role") @db.VarChar(50)

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relationships
  client    Client?    @relation(fields: [clientId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  auditLogs AuditLog[]

  @@index([userId])
  @@index([clientId])
  @@index([customerId])
  @@index([isActive])
  @@map("user_profiles")
}

// Client - for multi-tenant white-label support
model Client {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @db.VarChar(200)
  slug   String  @unique @db.VarChar(100) // URL-friendly identifier
  domain String? @unique @db.VarChar(255) // Custom domain

  // Contact information
  contactEmail String  @map("contact_email") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(20)

  // Business information
  businessType String? @map("business_type") @db.VarChar(100)
  industry     String? @db.VarChar(100)
  companySize  String? @map("company_size") @db.VarChar(50)

  // Address
  address Json? // Business address

  // Client status
  isActive         Boolean @default(true) @map("is_active")
  subscriptionTier String  @default("basic") @map("subscription_tier") @db.VarChar(50)

  // License integration for RBAC
  licenseId         String?       @unique @map("license_id") @db.Uuid
  licenseStatus     LicenseStatus @default(INACTIVE) @map("license_status")
  licenseValidUntil DateTime?     @map("license_valid_until")
  clientType        ClientType    @default(STANDARD) @map("client_type")
  dockerImageTag    String?       @map("docker_image_tag") @db.VarChar(100)
  deployedAt        DateTime?     @map("deployed_at")
  activationCode    String?       @unique @map("activation_code") @db.VarChar(1000) // License key for activation (JWT-style, ~500-800 chars)

  // Reseller fields
  isReseller     Boolean @default(false) @map("is_reseller")
  commissionRate Float?  @map("commission_rate") // Decimal as Float for commission percentage

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  userProfiles    UserProfile[]
  clientSettings  ClientSettings?
  userInvitations UserInvitation[]
  auditLogs       AuditLog[]
  clientUsers     ClientUser[]
  customers       Customer[]

  @@index([slug])
  @@index([isActive])
  @@index([licenseId])
  @@index([clientType])
  @@map("clients")
}

// Client Settings - for white-label branding and configuration
model ClientSettings {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // Branding
  brandName      String? @map("brand_name") @db.VarChar(200)
  logo           String? @db.VarChar(500) // Logo URL
  primaryColor   String? @map("primary_color") @db.VarChar(10) // Hex color
  secondaryColor String? @map("secondary_color") @db.VarChar(10)
  favicon        String? @db.VarChar(500) // Favicon URL

  // Configuration
  features     Json? // Enabled features for this client
  limits       Json? // Usage limits and quotas
  integrations Json? // Third-party integrations config

  // Email settings
  emailFromName    String? @map("email_from_name") @db.VarChar(100)
  emailFromAddress String? @map("email_from_address") @db.VarChar(255)
  emailTemplates   Json?   @map("email_templates") // Custom email templates

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_settings")
}

// User Invitation - for managing user invitations to clients
model UserInvitation {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  email    String @db.VarChar(255)
  role     Role   @default(client)

  // Invitation details
  invitedBy String @map("invited_by") @db.Uuid // User ID who sent invitation
  token     String @unique @db.VarChar(255) // Invitation token

  // Status and expiry
  status     InvitationStatus @default(pending)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("user_invitations")
}

// Audit Log - for compliance and security tracking
model AuditLog {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String? @map("user_id") @db.Uuid // From auth service
  userProfileId String? @map("user_profile_id") @db.Uuid // Local user profile
  clientId      String? @map("client_id") @db.Uuid

  // Action details
  action     String  @db.VarChar(100) // CREATE_PROFILE, UPDATE_CLIENT, etc.
  resource   String  @db.VarChar(100) // UserProfile, Client, etc.
  resourceId String? @map("resource_id") @db.Uuid

  // Change tracking
  changes  Json? // Before/after values
  metadata Json? // Additional context

  // Request context
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  requestId String? @map("request_id") @db.VarChar(100)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  userProfile UserProfile? @relation(fields: [userProfileId], references: [id])
  client      Client?      @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([userProfileId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ClientUser - Links users to clients with specific roles (accounts, sales, support)
model ClientUser {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @map("client_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid // Reference to auth-service User
  role                String   @db.VarChar(50) // accounts, sales, support
  accessLevel         String   @default("FULL") @map("access_level") @db.VarChar(20) // FULL or RESTRICTED
  assignedCustomerIds String[] @map("assigned_customer_ids") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
  @@map("client_users")
}

// Customer - End customers of a client (B2B/B2C customers using the logistics platform)
// CustomerType: DIRECT (B2C self-signup) or OUTLET (B2B managed by admin)
model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  clientId     String?      @map("client_id") @db.Uuid // Optional for direct customers
  customerType CustomerType @default(DIRECT) @map("customer_type")
  name         String       @db.VarChar(200)
  email        String       @db.VarChar(255)
  phone        String?      @db.VarChar(20)

  // Feature access control
  monthlyShipmentLimit Int?     @map("monthly_shipment_limit")
  enabledModules       String[] @map("enabled_modules") // ['shipment', 'billing', 'wallet', 'analytics']

  // Outlet-specific fields (only for customerType=OUTLET)
  outletCode    String? @unique @map("outlet_code") @db.VarChar(50)
  outletName    String? @map("outlet_name") @db.VarChar(200)
  retailerName  String? @map("retailer_name") @db.VarChar(200)
  contactPerson String? @map("contact_person") @db.VarChar(100)
  outletStatus  String? @map("outlet_status") @db.VarChar(20) // active, inactive, suspended
  outletType    String? @map("outlet_type") @db.VarChar(50) // franchise, direct, retail, warehouse

  // Outlet business details
  businessHours    String?  @map("business_hours") @db.VarChar(255)
  gstNumber        String?  @map("gst_number") @db.VarChar(20)
  panNumber        String?  @map("pan_number") @db.VarChar(20)
  bankDetails      Json?    @map("bank_details") // {bankName, accountNumber, ifscCode, accountHolderName}
  assignedCouriers String[] @map("assigned_couriers") // courier codes available at this outlet
  serviceAreas     String[] @map("service_areas") // pincodes or zones served

  // Outlet address (separate from client address)
  address String? @db.VarChar(500)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  pincode String? @db.VarChar(10)
  country String? @default("India") @db.VarChar(100)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userProfiles  UserProfile[]
  customerUsers CustomerUser[]
  commissions   Commission[] // Commissions for affiliate who referred this customer

  // Note: Unique constraint for email handled via raw SQL migration
  // Handles: unique(email) when clientId IS NULL, unique(clientId, email) when clientId IS NOT NULL
  @@index([clientId])
  @@index([email])
  @@index([customerType])
  @@map("customers")
}

// CustomerUser - Links users to customers with specific roles (customer, customer_account, customer_sales, customer_support)
model CustomerUser {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid // Reference to auth-service User
  role           String   @db.VarChar(50) // customer, customer_account, customer_sales, customer_support
  enabledModules String[] @map("enabled_modules") // Sub-access control within customer
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId])
  @@index([customerId])
  @@index([userId])
  @@map("customer_users")
}

// Commission - Affiliate commission tracking for referred customers
model Commission {
  id               String           @id @default(uuid()) @db.Uuid
  affiliateId      String           @map("affiliate_id") @db.Uuid // Reference to auth-service User with affiliate role
  customerId       String           @map("customer_id") @db.Uuid // Reference to Customer
  shipmentId       String?          @map("shipment_id") @db.Uuid // Reference to shipment (if per-shipment commission)
  commissionType   CommissionType   @map("commission_type") // FLAT or PERCENTAGE
  commissionRate   Float            @map("commission_rate") // Rate applied (percentage or flat amount)
  baseAmount       Decimal          @map("base_amount") @db.Decimal(15, 2) // Original shipment cost or base amount
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(15, 2) // Calculated commission
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?        @map("paid_at")
  payoutId         String?          @map("payout_id") @db.Uuid // Reference to wallet payout transaction
  metadata         Json? // Additional commission metadata
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([customerId])
  @@index([shipmentId])
  @@index([status])
  @@index([createdAt])
  @@map("commissions")
}

// Enums
enum Role {
  superadmin
  admin
  client
  accounts
  sales
  support
  customer
  customer_account
  customer_sales
  customer_support
  affiliate
}

enum InvitationStatus {
  pending
  accepted
  expired
  cancelled
}

enum ClientType {
  STANDARD // Regular platform user
  LICENSE_BASED // Secure Docker deployment
  RESELLER // Commission-based partner
}

enum LicenseStatus {
  INACTIVE // Not activated yet
  ACTIVE // Currently active
  SUSPENDED // Temporarily suspended
  EXPIRED // License expired
}

enum CommissionType {
  FLAT // Fixed amount per customer/shipment
  PERCENTAGE // Percentage of shipment cost
}

enum CommissionStatus {
  PENDING // Commission calculated but not approved
  APPROVED // Approved for payout
  PAID // Already paid to affiliate
  CANCELLED // Cancelled (e.g., customer refunded)
}

enum CustomerType {
  DIRECT // B2C direct self-signup customer
  OUTLET // B2B outlet/franchise managed by admin
}
