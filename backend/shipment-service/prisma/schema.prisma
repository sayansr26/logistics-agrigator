// Shipment Service Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shipment {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @map("order_id") @db.VarChar(100)
  clientId          String?        @map("client_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  outletId          String?        @map("outlet_id") @db.Uuid
  shipmentType      String         @default("B2C") @map("shipment_type") @db.VarChar(10)
  shipmentDirection String         @default("FORWARD") @map("shipment_direction") @db.VarChar(10)
  status            ShipmentStatus @default(CREATED)
  bookingStatus     String         @default("PENDING") @map("booking_status") @db.VarChar(30)
  paymentType       PaymentType    @default(PREPAID) @map("payment_type")
  paymentStatus     PaymentStatus  @default(PENDING) @map("payment_status")
  codAmount         Decimal?       @map("cod_amount") @db.Decimal(10, 2)
  totalCost         Decimal        @map("total_cost") @db.Decimal(10, 2)
  currency          String         @default("INR") @db.VarChar(3)

  // Cost / Profit split
  // `totalCost` above is the customer-facing SELLING charge (source of truth).
  // `courierCost` is what we pay the carrier (purchase amount); may come from
  // the courier API, a manual entry, or a cost-side charge rule.
  // `profitMargin` = totalCost (selling) - courierCost; null until courierCost captured.
  courierCost       Decimal? @map("courier_cost") @db.Decimal(10, 2)
  profitMargin      Decimal? @map("profit_margin") @db.Decimal(10, 2)
  courierCostSource String?  @map("courier_cost_source") @db.VarChar(20) // API | MANUAL | RULE

  // Pickup Address
  pickupAddressId String? @map("pickup_address_id") @db.Uuid
  pickupName      String  @map("pickup_name") @db.VarChar(100)
  pickupPhone     String  @map("pickup_phone") @db.VarChar(15)
  pickupEmail     String? @map("pickup_email") @db.VarChar(255)
  pickupLine1     String  @map("pickup_line1") @db.VarChar(255)
  pickupLine2     String? @map("pickup_line2") @db.VarChar(255)
  pickupLandmark  String? @map("pickup_landmark") @db.VarChar(100)
  pickupCity      String  @map("pickup_city") @db.VarChar(50)
  pickupState     String  @map("pickup_state") @db.VarChar(50)
  pickupPincode   String  @map("pickup_pincode") @db.VarChar(6)
  pickupCountry   String  @default("India") @map("pickup_country") @db.VarChar(50)

  // Delivery Address
  deliveryName     String  @map("delivery_name") @db.VarChar(100)
  deliveryPhone    String  @map("delivery_phone") @db.VarChar(15)
  deliveryEmail    String? @map("delivery_email") @db.VarChar(255)
  deliveryLine1    String  @map("delivery_line1") @db.VarChar(255)
  deliveryLine2    String? @map("delivery_line2") @db.VarChar(255)
  deliveryLandmark String? @map("delivery_landmark") @db.VarChar(100)
  deliveryCity     String  @map("delivery_city") @db.VarChar(50)
  deliveryState    String  @map("delivery_state") @db.VarChar(50)
  deliveryPincode  String  @map("delivery_pincode") @db.VarChar(6)
  deliveryCountry  String  @default("India") @map("delivery_country") @db.VarChar(50)

  // RTO (Return To Origin) Address
  rtoSameAsPickup Boolean @default(true) @map("rto_same_as_pickup")
  rtoName         String? @map("rto_name") @db.VarChar(100)
  rtoPhone        String? @map("rto_phone") @db.VarChar(15)
  rtoLine1        String? @map("rto_line1") @db.VarChar(255)
  rtoLine2        String? @map("rto_line2") @db.VarChar(255)
  rtoLandmark     String? @map("rto_landmark") @db.VarChar(100)
  rtoCity         String? @map("rto_city") @db.VarChar(50)
  rtoState        String? @map("rto_state") @db.VarChar(50)
  rtoPincode      String? @map("rto_pincode") @db.VarChar(6)
  rtoCountry      String? @default("India") @map("rto_country") @db.VarChar(50)

  // Product Information
  productDescription String?  @map("product_description") @db.Text
  hsnCode            String?  @map("hsn_code") @db.VarChar(20)
  gstPercentage      Decimal? @map("gst_percentage") @db.Decimal(5, 2)

  // Package Details
  numberOfBoxes     Int      @default(1) @map("number_of_boxes")
  weight            Decimal  @db.Decimal(8, 3)
  length            Decimal  @db.Decimal(8, 2)
  width             Decimal  @db.Decimal(8, 2)
  height            Decimal  @db.Decimal(8, 2)
  volumetricWeight  Decimal? @map("volumetric_weight") @db.Decimal(8, 3)
  chargeableWeight  Decimal? @map("chargeable_weight") @db.Decimal(8, 3)
  volumetricDivisor Decimal? @map("volumetric_divisor") @db.Decimal(10, 2)
  description       String?  @db.VarChar(500)
  value             Decimal? @db.Decimal(12, 2)
  fragile           Boolean  @default(false)

  // Service Details
  serviceType         ServiceType @default(STANDARD) @map("service_type")
  specialInstructions String?     @map("special_instructions") @db.VarChar(500)

  // Partner Integration
  partnerId         String? @map("partner_id") @db.VarChar(50)
  partnerName       String? @map("partner_name") @db.VarChar(100)
  awbNumber         String? @map("awb_number") @db.VarChar(50)
  partnerShipmentId String? @map("partner_shipment_id") @db.VarChar(100)
  trackingUrl       String? @map("tracking_url") @db.VarChar(500)

  // Rule-based channel the shipment was booked on (display/reporting; the
  // authoritative FK lives in partner-service PartnerShipment.serviceChannelId)
  courierChannelId   String? @map("courier_channel_id") @db.Uuid
  courierChannelName String? @map("courier_channel_name") @db.VarChar(150)

  // Provider sync metadata
  providerStatus      String?   @map("provider_status") @db.VarChar(50)
  providerLastSyncAt  DateTime? @map("provider_last_sync_at")
  providerRawResponse Json?     @map("provider_raw_response")

  // Label / document metadata
  courierLabelUrl       String?   @map("courier_label_url") @db.VarChar(500)
  courierLabelFormat    String?   @map("courier_label_format") @db.VarChar(20)
  courierLabelFetchedAt DateTime? @map("courier_label_fetched_at")

  // Pickup metadata
  pickupRequestId   String?   @map("pickup_request_id") @db.VarChar(100)
  pickupRequestedAt DateTime? @map("pickup_requested_at")
  pickupConfirmedAt DateTime? @map("pickup_confirmed_at")

  // Quote Snapshot - stores the selected quote at creation time
  quoteSnapshot Json? @map("quote_snapshot")

  // Wallet Integration
  walletTransactionId String?  @map("wallet_transaction_id") @db.VarChar(100)
  walletUserId        String?  @map("wallet_user_id") @db.VarChar(20)
  paymentReference    String?  @map("payment_reference") @db.VarChar(100)
  refundTransactionId String?  @map("refund_transaction_id") @db.VarChar(100)
  refundAmount        Decimal? @map("refund_amount") @db.Decimal(10, 2)

  // Dispute / Re-rate
  disputeStatus  String?  @map("dispute_status") @db.VarChar(30)
  disputedWeight Decimal? @map("disputed_weight") @db.Decimal(8, 3)
  disputedLength Decimal? @map("disputed_length") @db.Decimal(8, 2)
  disputedWidth  Decimal? @map("disputed_width") @db.Decimal(8, 2)
  disputedHeight Decimal? @map("disputed_height") @db.Decimal(8, 2)
  disputedCost   Decimal? @map("disputed_cost") @db.Decimal(10, 2)
  holdReason     String?  @map("hold_reason") @db.VarChar(500)

  // Dates
  estimatedPickup    DateTime? @map("estimated_pickup")
  actualPickup       DateTime? @map("actual_pickup")
  estimatedDelivery  DateTime? @map("estimated_delivery")
  actualDelivery     DateTime? @map("actual_delivery")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(500)

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  trackingEvents       TrackingEvent[]
  ndrCases             NDRCase[]
  financialAdjustments ShipmentFinancialAdjustment[]
  invoices             ShipmentInvoice[]
  boxes                ShipmentBox[]
  documents            ShipmentDocument[]

  // Pickup schedule relation
  pickupScheduleId String?         @map("pickup_schedule_id") @db.Uuid
  pickupSchedule   PickupSchedule? @relation(fields: [pickupScheduleId], references: [id])

  @@unique([orderId, clientId])
  @@index([clientId, status, createdAt])
  @@index([userId, createdAt])
  @@index([outletId, createdAt])
  @@index([orderId, clientId])
  @@index([awbNumber])
  @@index([status])
  @@index([bookingStatus])
  @@index([partnerId])
  @@index([pickupScheduleId])
  @@index([disputeStatus])
  @@map("shipments")
}

model TrackingEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  status     String   @db.VarChar(50)
  message    String   @db.VarChar(500)
  location   String?  @db.VarChar(100)
  eventData  Json?    @map("event_data") // Additional event metadata
  source     String   @default("SYSTEM") @db.VarChar(50) // SYSTEM, PARTNER, MANUAL
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, timestamp])
  @@index([status])
  @@map("tracking_events")
}

model ShipmentInvoice {
  id            String   @id @default(uuid()) @db.Uuid
  shipmentId    String   @map("shipment_id") @db.Uuid
  eWayBillNo    String?  @map("eway_bill_no") @db.VarChar(50)
  invoiceNo     String   @map("invoice_no") @db.VarChar(100)
  invoiceAmt    Decimal  @map("invoice_amt") @db.Decimal(12, 2)
  invoiceDate   DateTime @map("invoice_date")
  attachmentUrl String?  @map("attachment_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_invoices")
}

model ShipmentBox {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  boxNumber  Int      @map("box_number")
  length     Decimal  @db.Decimal(8, 2)
  width      Decimal  @db.Decimal(8, 2)
  height     Decimal  @db.Decimal(8, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_boxes")
}

model ShipmentDocument {
  id         String    @id @default(uuid()) @db.Uuid
  shipmentId String    @map("shipment_id") @db.Uuid
  type       String    @db.VarChar(50)
  name       String    @db.VarChar(200)
  url        String?   @db.VarChar(500)
  data       String?   @db.Text
  format     String?   @db.VarChar(20)
  source     String    @default("SYSTEM") @db.VarChar(50)
  metadata   Json?
  fetchedAt  DateTime? @map("fetched_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, type])
  @@map("shipment_documents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.Uuid
  changes    Json? // What changed - before/after values
  metadata   Json? // Additional context
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  clientId   String?  @map("client_id") @db.Uuid // For multi-tenant audit trails
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([resource, resourceId])
  @@index([clientId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateCache {
  id          String      @id @default(uuid()) @db.Uuid
  cacheKey    String      @unique @map("cache_key") @db.VarChar(255)
  fromPincode String      @map("from_pincode") @db.VarChar(6)
  toPincode   String      @map("to_pincode") @db.VarChar(6)
  weight      Decimal     @db.Decimal(8, 3)
  serviceType ServiceType @map("service_type")
  partnerId   String?     @map("partner_id") @db.VarChar(50)
  rateData    Json        @map("rate_data") // Cached rate calculation response
  expiresAt   DateTime    @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([cacheKey])
  @@index([fromPincode, toPincode])
  @@index([expiresAt])
  @@map("rate_cache")
}

model ServiceabilityCache {
  id           String      @id @default(uuid()) @db.Uuid
  cacheKey     String      @unique @map("cache_key") @db.VarChar(255)
  fromPincode  String      @map("from_pincode") @db.VarChar(6)
  toPincode    String      @map("to_pincode") @db.VarChar(6)
  serviceType  ServiceType @map("service_type")
  partnerId    String?     @map("partner_id") @db.VarChar(50)
  serviceable  Boolean
  responseData Json?       @map("response_data") // Partner response
  expiresAt    DateTime    @map("expires_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([cacheKey])
  @@index([fromPincode, toPincode])
  @@index([expiresAt])
  @@map("serviceability_cache")
}

model ShipmentFinancialAdjustment {
  id             String  @id @default(uuid()) @db.Uuid
  shipmentId     String  @map("shipment_id") @db.Uuid
  adjustmentType String  @map("adjustment_type") @db.VarChar(30)
  reason         String  @db.VarChar(500)
  oldAmount      Decimal @map("old_amount") @db.Decimal(10, 2)
  newAmount      Decimal @map("new_amount") @db.Decimal(10, 2)
  difference     Decimal @db.Decimal(10, 2)

  refundTransactionId String? @map("refund_transaction_id") @db.VarChar(100)
  chargeTransactionId String? @map("charge_transaction_id") @db.VarChar(100)

  disputedWeight Decimal? @map("disputed_weight") @db.Decimal(8, 3)
  disputedLength Decimal? @map("disputed_length") @db.Decimal(8, 2)
  disputedWidth  Decimal? @map("disputed_width") @db.Decimal(8, 2)
  disputedHeight Decimal? @map("disputed_height") @db.Decimal(8, 2)

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([adjustmentType])
  @@map("shipment_financial_adjustments")
}

// Enums
enum ShipmentStatus {
  CREATED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
  NDR
  HOLD
}

enum PaymentType {
  PREPAID
  COD
}

enum PaymentStatus {
  PENDING
  RESERVED
  CONFIRMED
  FAILED
  REFUNDED
  REFUND_FAILED
  NO_REFUND
}

enum ServiceType {
  STANDARD
  EXPRESS
  ECONOMY
}

// NDR (Non-Delivery Report) Case Management
model NDRCase {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @map("shipment_id") @db.Uuid
  reason      String    @db.VarChar(50) // DELIVERY_FAILED, ADDRESS_ISSUE, CUSTOMER_UNAVAILABLE, etc.
  description String?   @db.Text
  status      NDRStatus @default(OPEN)
  priority    Priority  @default(MEDIUM)

  // Delivery attempt details
  deliveryAttemptDate DateTime @map("delivery_attempt_date")
  customerFeedback    String?  @map("customer_feedback") @db.Text
  deliveryPersonNotes String?  @map("delivery_person_notes") @db.Text
  addressIssue        Boolean  @default(false) @map("address_issue")
  customerUnavailable Boolean  @default(false) @map("customer_unavailable")

  // Reattempt management
  reattemptRequested     Boolean   @default(true) @map("reattempt_requested")
  reattemptDate          DateTime? @map("reattempt_date")
  reattemptNotes         String?   @map("reattempt_notes") @db.Text
  reattemptScheduledAt   DateTime? @map("reattempt_scheduled_at")
  reattemptScheduledById String?   @map("reattempt_scheduled_by_id") @db.Uuid
  preferredReattemptDate DateTime? @map("preferred_reattempt_date")

  // Address update management
  addressUpdateNotes String?   @map("address_update_notes") @db.Text
  addressUpdatedAt   DateTime? @map("address_updated_at")
  addressUpdatedById String?   @map("address_updated_by_id") @db.Uuid

  // RTO management
  rtoInitiatedAt   DateTime? @map("rto_initiated_at")
  rtoInitiatedById String?   @map("rto_initiated_by_id") @db.Uuid
  rtoNotes         String?   @map("rto_notes") @db.Text

  // Case management
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  assignedAt   DateTime? @map("assigned_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolution   String?   @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([shipmentId])
  @@index([status, priority])
  @@index([reason])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("ndr_cases")
}

// Bulk Operation Job Management
model BulkJob {
  id     String    @id @default(uuid()) @db.Uuid
  type   JobType   @default(BULK_SHIPMENT)
  status JobStatus @default(PENDING)

  // Job details
  totalRecords      Int @map("total_records")
  processedRecords  Int @default(0) @map("processed_records")
  successfulRecords Int @default(0) @map("successful_records")
  failedRecords     Int @default(0) @map("failed_records")

  // File information
  fileName String? @map("file_name") @db.VarChar(255)
  fileSize Int?    @map("file_size")
  filePath String? @map("file_path") @db.VarChar(500)

  // Processing details
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  errorMessage     String?   @map("error_message") @db.Text
  processingTimeMs Int?      @map("processing_time_ms")

  // User and client context
  createdById String  @map("created_by_id") @db.Uuid
  clientId    String? @map("client_id") @db.Uuid

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Indexes
  @@index([createdById, type])
  @@index([status, type])
  @@index([createdAt])
  @@index([clientId])
  @@map("bulk_jobs")
}

// Pickup Scheduling
model PickupSchedule {
  id          String  @id @default(uuid()) @db.Uuid
  clientId    String? @map("client_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  partnerId   String  @map("partner_id") @db.VarChar(100)
  partnerName String  @map("partner_name") @db.VarChar(100)

  // Schedule details
  scheduledDate DateTime     @map("scheduled_date")
  timeSlot      String       @map("time_slot") @db.VarChar(20) // "10:00-12:00", "14:00-16:00", etc.
  status        PickupStatus @default(SCHEDULED)

  // Address details
  pickupName     String  @map("pickup_name") @db.VarChar(100)
  pickupPhone    String  @map("pickup_phone") @db.VarChar(15)
  pickupEmail    String? @map("pickup_email") @db.VarChar(255)
  pickupLine1    String  @map("pickup_line1") @db.VarChar(255)
  pickupLine2    String? @map("pickup_line2") @db.VarChar(255)
  pickupLandmark String? @map("pickup_landmark") @db.VarChar(100)
  pickupCity     String  @map("pickup_city") @db.VarChar(50)
  pickupState    String  @map("pickup_state") @db.VarChar(50)
  pickupPincode  String  @map("pickup_pincode") @db.VarChar(6)
  pickupCountry  String  @default("India") @map("pickup_country") @db.VarChar(50)

  // Pickup details
  totalShipments      Int     @default(0) @map("total_shipments")
  totalWeight         Decimal @default(0) @map("total_weight") @db.Decimal(8, 3)
  specialInstructions String? @map("special_instructions") @db.Text

  // Partner communication
  partnerRequestId String? @map("partner_request_id") @db.VarChar(100)
  partnerResponse  Json?   @map("partner_response")
  confirmationCode String? @map("confirmation_code") @db.VarChar(20)

  // Pickup execution
  pickedUpAt      DateTime? @map("picked_up_at")
  pickedUpBy      String?   @map("picked_up_by") @db.VarChar(100)
  actualWeight    Decimal?  @map("actual_weight") @db.Decimal(8, 3)
  actualShipments Int?      @map("actual_shipments")
  pickupNotes     String?   @map("pickup_notes") @db.Text

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  shipments Shipment[]

  // Indexes
  @@index([scheduledDate, status])
  @@index([partnerId])
  @@index([userId, clientId])
  @@index([status])
  @@map("pickup_schedules")
}

// Additional Enums

// NDR Status
enum NDRStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  REATTEMPT_SCHEDULED
  ADDRESS_UPDATED
  RTO_INITIATED
  RESOLVED
  CLOSED

  @@map("ndr_status")
}

// Priority levels
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("priority")
}

// Job Types
enum JobType {
  BULK_SHIPMENT
  BULK_UPDATE
  BULK_CANCEL
  DATA_EXPORT
  DATA_IMPORT

  @@map("job_type")
}

// Job Status
enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("job_status")
}

// Pickup Status
enum PickupStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED

  @@map("pickup_status")
}
