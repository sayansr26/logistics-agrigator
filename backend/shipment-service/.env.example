# Environment variables for Shipment Service

# Database
DATABASE_URL="postgresql://logistics:logistics123@localhost:5432/logistics_shipments"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="3600"

# Service Configuration
NODE_ENV="development"
PORT="8003"

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL="http://localhost:8001"
USER_SERVICE_URL="http://localhost:8002"
API_GATEWAY_URL="http://localhost:8000"
SUPPORT_SERVICE_URL="http://localhost:8004"
PLATFORM_SERVICE_URL="http://localhost:8005"

# External Services
WALLET_SERVICE_URL="http://localhost:8006"
WALLET_SERVICE_API_KEY="your_wallet_service_api_key"
PARTNER_SERVICE_URL="http://localhost:8007"
PARTNER_SERVICE_API_KEY="your_partner_service_api_key"

# Prisma
PRISMA_QUERY_ENGINE_BINARY=""

# Shipment Service Specific
TRACKING_URL_BASE="http://localhost:3000/track"
SHIPMENT_LABEL_UPLOAD_PATH="uploads/labels"
SHIPMENT_DOCUMENT_UPLOAD_PATH="uploads/documents"
MAX_PACKAGE_WEIGHT="50000"
DEFAULT_CURRENCY="INR"

# Courier Integration
COURIER_WEBHOOK_SECRET="your_courier_webhook_secret"
COURIER_API_TIMEOUT="30000"

# Notification Settings
SMS_PROVIDER="msg91"
MSG91_API_KEY="your_msg91_api_key"
EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="your_sendgrid_api_key"
