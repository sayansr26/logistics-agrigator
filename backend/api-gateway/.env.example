# Environment variables for API Gateway

# Database (for gateway-specific data like rate limiting, analytics)
DATABASE_URL="postgresql://logistics:logistics123@localhost:3008/logistics_gateway"

# Redis (for rate limiting, caching, session storage)
REDIS_URL="redis://localhost:3009"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="3600"

# Service Configuration
NODE_ENV="development"
PORT="3001"

# Microservice URLs (for proxying requests)
AUTH_SERVICE_URL="http://localhost:3002"
USER_SERVICE_URL="http://localhost:3003"
SHIPMENT_SERVICE_URL="http://localhost:3004"
SUPPORT_SERVICE_URL="http://localhost:3006"
PLATFORM_SERVICE_URL="http://localhost:3007"
PARTNER_SERVICE_URL="http://localhost:3005"

# External Services
WALLET_SERVICE_URL="http://localhost:8006"
WALLET_SERVICE_API_KEY="your_wallet_service_api_key"
PARTNER_SERVICE_EXTERNAL_URL="https://calc.websiteduniya.com"
PARTNER_SERVICE_API_KEY="your_partner_service_api_key"

# Prisma
PRISMA_QUERY_ENGINE_BINARY=""

# API Gateway Specific Configuration
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS="false"

# Request Timeout
REQUEST_TIMEOUT="30000"
SERVICE_TIMEOUT="25000"

# Logging and Monitoring
LOG_LEVEL="debug"
ENABLE_REQUEST_LOGGING="true"
ENABLE_ERROR_TRACKING="true"

# Health Check Configuration
HEALTH_CHECK_INTERVAL="30000"
SERVICE_HEALTH_TIMEOUT="5000"

# Security
HELMET_ENABLED="true"
TRUST_PROXY="true"
MAX_REQUEST_SIZE="10mb"

# Load Balancing (if multiple instances)
LOAD_BALANCER_STRATEGY="round-robin"
CIRCUIT_BREAKER_ENABLED="true"
CIRCUIT_BREAKER_THRESHOLD="5"
