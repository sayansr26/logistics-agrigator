# =============== PRODUCTION DOCKERFILE ===============
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json yarn.lock ./
COPY shared/package.json ./shared/package.json
COPY backend/api-gateway/package.json ./backend/api-gateway/package.json

RUN yarn install --frozen-lockfile --production --ignore-scripts

COPY shared ./shared
COPY backend/api-gateway ./backend/api-gateway

# Copy shared into service directory for relative imports
RUN cp -r /app/shared /app/backend/api-gateway/

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
RUN mkdir -p /app/logs/api-gateway && chown -R nodejs:nodejs /app/logs
RUN chown -R nodejs:nodejs /app

USER nodejs
WORKDIR /app

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001

CMD ["node", "backend/api-gateway/server.js"]
