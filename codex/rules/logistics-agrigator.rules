# Repo-local Codex rules for logistics-agrigator
# Docs: https://developers.openai.com/codex/rules
#
# Purpose:
# - Auto-allow common read-only inspection commands outside the sandbox
# - Prompt for commands that can mutate the repo, install deps, or affect Docker

# -----------------------
# Read-only inspection
# -----------------------

prefix_rule(
    pattern = [["ls", "cat", "head", "tail", "wc", "nl", "sed", "find", "rg"]],
    decision = "allow",
    justification = "Read-only repo inspection commands are safe to auto-run.",
    match = [
        "rg -n \"TODO\" README.md",
        "find . -maxdepth 2 -type f",
        "ls -la",
        "cat CLAUDE.md",
    ],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "blame", "rev-parse"]],
    decision = "allow",
    justification = "Read-only git inspection is safe to auto-run.",
    match = [
        "git status",
        "git diff",
        "git log -n 20 --oneline",
        "git show HEAD:README.md",
    ],
)

# -----------------------
# Shell wrappers
# -----------------------

prefix_rule(
    pattern = [["bash", "zsh", "sh"], ["-lc", "-c"]],
    decision = "prompt",
    justification = "Shell wrappers can hide multiple commands; require approval.",
    match = [
        "bash -lc \"git status\"",
    ],
)

# -----------------------
# Repo mutation
# -----------------------

prefix_rule(
    pattern = [["rm", "mv", "cp", "chmod", "chown", "mkdir", "rmdir"]],
    decision = "prompt",
    justification = "Filesystem mutation should require explicit approval when outside the sandbox.",
    match = [
        "rm -f /tmp/example.txt",
        "mkdir -p /tmp/example-dir",
    ],
)

prefix_rule(
    pattern = ["git", ["add", "commit", "push", "pull", "fetch", "checkout", "switch", "restore", "reset", "rebase", "merge", "cherry-pick", "clean", "stash"]],
    decision = "prompt",
    justification = "Git write operations should require approval when outside the sandbox.",
    match = [
        "git add .",
        "git commit -m \"chore: test\"",
    ],
)

# -----------------------
# Project tooling (pnpm)
# -----------------------

prefix_rule(
    pattern = ["pnpm", ["install", "add", "remove", "update", "exec", "dlx", "run"]],
    decision = "prompt",
    justification = "pnpm can install dependencies or execute arbitrary scripts; require approval outside the sandbox.",
    match = [
        "pnpm run dev",
        "pnpm run db:init",
        "pnpm install",
    ],
)

# -----------------------
# Docker / docker-compose
# -----------------------

# Allow read-only container status and logs (common when debugging).
prefix_rule(
    pattern = ["docker", ["ps", "logs", "inspect"]],
    decision = "allow",
    justification = "Docker status/log inspection is read-only.",
    match = [
        "docker ps",
    ],
)

prefix_rule(
    pattern = ["docker-compose", "ps"],
    decision = "allow",
    justification = "docker-compose ps is read-only.",
    match = [
        "docker-compose ps",
    ],
)

prefix_rule(
    pattern = ["docker-compose", "logs"],
    decision = "allow",
    justification = "docker-compose logs is read-only.",
    match = [
        "docker-compose logs -f",
    ],
)

# Prompt for any compose operations that start/stop/exec/build.
prefix_rule(
    pattern = ["docker-compose", ["up", "down", "restart", "exec", "build", "pull"]],
    decision = "prompt",
    justification = "docker-compose can start/stop services, build images, or exec into containers.",
    match = [
        "docker-compose up -d",
        "docker-compose exec api-gateway node -v",
    ],
)

prefix_rule(
    pattern = ["docker-compose", "--profile", "all-services", ["up", "down"]],
    decision = "prompt",
    justification = "Project scripts use docker-compose profiles to start/stop stacks.",
    match = [
        "docker-compose --profile all-services up",
    ],
)

prefix_rule(
    pattern = ["docker", ["exec", "run", "build", "compose", "restart", "stop", "rm", "rmi", "system", "volume", "network"]],
    decision = "prompt",
    justification = "Docker mutation should require approval outside the sandbox.",
    match = [
        "docker restart logistics-frontend",
    ],
)

